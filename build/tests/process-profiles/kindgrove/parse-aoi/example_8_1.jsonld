    "relatedMatch": [
      "https://www.opengis.net/def/bblocks/ogc.openeo.types.bounding-box"
    ],
    "openeoEquivalence": {
      "level": "none",
      "rationale": "Structural helper: unpacks an OGC BBox record into west/south/east/north floats and emits a constant `output_dir` (\"outputs\"). No openEO process does this, because openEO passes a bounding box object directly (`ogc.openeo.types.bounding-box`, relatedMatch at type level)."
    }
