@prefix ns1: <https://w3id.org/ogc/api/processes/> .
@prefix ns2: <http://www.iana.org/assignments/> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pp: <https://geolabs.github.io/bblocks-process-profiles/def/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix rim: <https://w3id.org/ogc/rim/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<file:///github/workspace/export_stac> rdfs:seeAlso <https://ospd.example.org/ogc-api/processes/export_stac> ;
    pp:version "0.1.0" .

<https://geolabs.github.io/bblocks-process-profiles/def/process-type/kindgrove-steps/export-stac/actions/addition> a rim:RegisterAction ;
    prov:startedAtTime "2026-09-22T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType rim:additionAction ;
    rim:appliesTo <https://geolabs.github.io/bblocks-process-profiles/def/process-type/kindgrove-steps/export-stac> ;
    rim:proposer pp:geolabs .

<https://geolabs.github.io/bblocks-process-profiles/def/process-type/kindgrove-steps/export-stac/actions/d5-2026-11-09> a rim:RegisterAction ;
    dct:description "Decision D5: the meaning of the type (prefLabel, definition, subClassOf) is kept apart from the rest. The six-phase position moves from skos:broader to pp:phase (classification); profile, processDescription and provenanceClass move to a node of their own (pp:deployment); the openEO correspondences are grouped apart. The plan was already a node of its own." ;
    prov:startedAtTime "2026-11-09T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType pp:amendmentAction ;
    rim:appliesTo <https://geolabs.github.io/bblocks-process-profiles/def/process-type/kindgrove-steps/export-stac> ;
    rim:changeClassification rim:substantiveChange ;
    rim:proposer pp:geolabs .

<https://geolabs.github.io/bblocks-process-profiles/def/process-type/kindgrove-steps/export-stac/actions/not-attached-2026-11-11> a rim:RegisterAction ;
    dct:description "notAttached added (absent -> {reason}): the entry now states that this CommandLineTool implements no Implementation Profile, with the reason already given in docs/ATTACHMENTS.md (profiles.yaml tier3.reason). Nothing else changes: the process was not attached before and is not attached now (decision Q1 of 2026-11-11)." ;
    prov:startedAtTime "2026-11-11T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType pp:amendmentAction ;
    rim:appliesTo <https://geolabs.github.io/bblocks-process-profiles/def/process-type/kindgrove-steps/export-stac> ;
    rim:changeClassification rim:clarifyingChange ;
    rim:proposer pp:geolabs .

<https://geolabs.github.io/bblocks-process-profiles/def/process-type/kindgrove-steps/export-stac/actions/plan-2026-11-11> a rim:RegisterAction ;
    dct:description "plan: executionUnit.href moves from the v0.0.2-rc2 release of GeoLabs/KindGrove to the v0.0.2-rc3 release (mangrove-workflow-steps.cwl#export_stac). The rc3 CWL declares the format of its Files (the ipython2cwl format annotation), so the processDescription derived from it changes: contentMediaType application/octet-stream -> image/tiff; application=geotiff (with contentEncoding binary) for the inputs biomass_file and mangrove_mask_file, and application/octet-stream -> application/geo+json (with contentEncoding binary) for the input stac_item, in processDescription.json and processDescription.raw.json." ;
    prov:startedAtTime "2026-11-11T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType pp:amendmentAction ;
    rim:appliesTo <https://geolabs.github.io/bblocks-process-profiles/def/process-type/kindgrove-steps/export-stac> ;
    rim:changeClassification rim:substantiveChange ;
    rim:proposer pp:geolabs .

<https://ospd.example.org/ogc-api/processes/export_stac/package> a prov:Plan ;
    dct:license <https://spdx.org/licenses/CC-BY-NC-SA-4.0> ;
    pp:candidateCctDependency "eoap.cct.stac" ;
    pp:cwlClass "CommandLineTool" ;
    pp:cwlId "export_stac" ;
    ns1:executionUnit [ dct:format "application/cwl+yaml" ;
            ns2:relation <http://www.opengis.net/def/rel/ogc/1.0/executionUnit> ;
            oa:hasTarget <https://github.com/GeoLabs/KindGrove/releases/download/v0.0.2-rc3/mangrove-workflow-steps.cwl#export_stac> ] .

<https://geolabs.github.io/bblocks-process-profiles/def/process-type/kindgrove-steps/export-stac> a owl:Class,
        pp:ProcessType,
        acttype:ActivityType ;
    rdfs:subClassOf acttype:ActivityType ;
    skos:closeMatch <https://www.opengis.net/def/bblocks/ogc.openeo.processes.cubes.save_result> ;
    skos:definition "Plots the biomass map and exports the mangrove analysis results as a STAC Catalog." ;
    skos:inScheme pp:process-type ;
    skos:prefLabel "Plot the biomass map and export a STAC catalog" ;
    pp:deployment [ pp:processDescription <file:///github/workspace/export_stac> ;
            pp:profile "ospd.process-profiles.kindgrove-steps.export-stac" ;
            pp:provenanceClass <http://purl.org/wf4ever/wfprov#ProcessRun> ] ;
    pp:notAttached [ skos:note "" ] ;
    pp:openeoEquivalence [ pp:equivalenceLevel "closeMatch" ;
            pp:rationale "Writes the final rasters and summaries to a self-describing STAC output, plus a quicklook PNG rendering; save_result's STAC output option is the closest openEO equivalent, same partial match as `algae-bloom.plot-image` and `water-bodies.stac`." ] ;
    pp:phase <https://geolabs.github.io/bblocks-process-profiles/def/phase/export-aggregation> ;
    pp:plan <https://ospd.example.org/ogc-api/processes/export_stac/package> ;
    rim:hasAction <https://geolabs.github.io/bblocks-process-profiles/def/process-type/kindgrove-steps/export-stac/actions/addition>,
        <https://geolabs.github.io/bblocks-process-profiles/def/process-type/kindgrove-steps/export-stac/actions/d5-2026-11-09>,
        <https://geolabs.github.io/bblocks-process-profiles/def/process-type/kindgrove-steps/export-stac/actions/not-attached-2026-11-11>,
        <https://geolabs.github.io/bblocks-process-profiles/def/process-type/kindgrove-steps/export-stac/actions/plan-2026-11-11> ;
    rim:inRegister pp:register ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://geolabs.github.io/bblocks-process-profiles/def/process-type/kindgrove-steps/export-stac"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:invalid .

