    "sync-execute",
    "async-execute",
    "dismiss"
  ],
  "outputTransmission": [
    "value",
    "reference"
  ],
  "inputs": {
    "SHAPES": {
      "title": "Shapes",
      "description": "Shapes",
      "schema": {
        "oneOf": [
          {
            "type": "string",
            "contentEncoding": "utf-8",
            "contentMediaType": "text/xml"
          },
          {
            "type": "string",
            "contentEncoding": "base64",
            "contentMediaType": "application/vnd.google-earth.kml+xml"
          },
          {
            "type": "object"
          }
        ]
      }
    },
    "OUTPUT": {
      "title": "Get Extent for ...",
      "description": "Get Extent for ...",
      "minOccurs": 0,
      "schema": {
        "type": "string",
