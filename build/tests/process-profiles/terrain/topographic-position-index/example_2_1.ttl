@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <https://geolabs.github.io/bblocks-process-profiles/def/output/> .
@prefix ns2: <https://geolabs.github.io/bblocks-process-profiles/def/input/> .
@prefix ns3: <https://w3id.org/ogc/api/schema/> .
@prefix ns4: <http://www.iana.org/assignments/> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix pp: <https://geolabs.github.io/bblocks-process-profiles/def/> .
@prefix proc: <https://w3id.org/ogc/api/processes/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://geolabs.github.io/bblocks-process-profiles/def/process/SAGA.ta_morphometry.18> dcterms:description "Topographic Position Index (TPI) calculation as proposed by Guisan et al. (1999). This is literally the same as the difference to the mean calculation (residual analysis) proposed by Wilson & Gallant (2000). The bandwidth parameter for distance weighting is given as percentage of the (outer) radius." ;
    dcterms:title "Topographic Position Index (TPI)" ;
    rdfs:seeAlso [ rdfs:label "Execute End Point" ;
            dcterms:type "application/json" ;
            ns4:relation <http://www.opengis.net/def/rel/ogc/1.0/execute> ;
            oa:hasTarget <https://host1.tb.geonovum.geolabs.fr/ogc-api/processes/SAGA.ta_morphometry.18/execution> ] ;
    pp:version "1.0.0" ;
    proc:inputs [ ns2:DEM [ dcterms:description "Elevation" ;
                    dcterms:title "Elevation" ;
                    proc:schema [ ns3:oneOf [ proc:type "string" ;
                                    ns3:contentEncoding "base64" ;
                                    ns3:contentMediaType "application/x-ogc-envi" ],
                                [ proc:type "string" ;
                                    ns3:contentEncoding "base64" ;
                                    ns3:contentMediaType "image/png" ],
                                [ proc:type "string" ;
                                    ns3:contentEncoding "base64" ;
                                    ns3:contentMediaType "image/tiff" ],
                                [ proc:type "string" ;
                                    ns3:contentEncoding "base64" ;
                                    ns3:contentMediaType "application/x-ogc-aaigrid" ] ] ] ;
            ns2:DW_BANDWIDTH [ dcterms:description "Gaussian and Exponential Weighting Bandwidth" ;
                    dcterms:title "Gaussian and Exponential Weighting Bandwidth" ;
                    proc:minOccurs 0 ;
                    proc:schema [ proc:default "75"^^rdf:JSON ;
                            proc:nullable true ;
                            proc:type "number" ;
                            ns3:format "float" ] ] ;
            ns2:DW_IDW_OFFSET [ dcterms:description "Calculates weights for distance plus one, avoiding division by zero for zero distances" ;
                    dcterms:title "Inverse Distance Offset" ;
                    proc:minOccurs 0 ;
                    proc:schema [ proc:default "true"^^rdf:JSON ;
                            proc:enum "false",
                                "true" ;
                            proc:nullable true ;
                            proc:type "boolean" ] ] ;
            ns2:DW_IDW_POWER [ dcterms:description "Inverse Distance Weighting Power" ;
                    dcterms:title "Inverse Distance Weighting Power" ;
                    proc:minOccurs 0 ;
                    proc:schema [ proc:default "1"^^rdf:JSON ;
                            proc:nullable true ;
                            proc:type "number" ;
                            ns3:format "float" ] ] ;
            ns2:DW_WEIGHTING [ dcterms:description "Weighting Function" ;
                    dcterms:title "Weighting Function" ;
                    proc:minOccurs 0 ;
                    proc:schema [ proc:default "\"no distance weighting\""^^rdf:JSON ;
                            proc:enum "exponential",
                                "gaussian weighting",
                                "inverse distance to a power",
                                "no distance weighting" ;
                            proc:nullable true ;
                            proc:type "string" ] ] ;
            ns2:RADIUS_MAX [ dcterms:description "kernel radius in map units" ;
                    dcterms:title "Scale (max value)" ;
                    proc:minOccurs 0 ;
                    proc:schema [ proc:nullable true ;
                            proc:type "number" ;
                            ns3:format "float" ] ] ;
            ns2:RADIUS_MIN [ dcterms:description "kernel radius in map units" ;
                    dcterms:title "Scale (min value)" ;
                    proc:minOccurs 0 ;
                    proc:schema [ proc:nullable true ;
                            proc:type "number" ;
                            ns3:format "float" ] ] ;
            ns2:STANDARD [ dcterms:description "Standardize" ;
                    dcterms:title "Standardize" ;
                    proc:minOccurs 0 ;
                    proc:schema [ proc:default "false"^^rdf:JSON ;
                            proc:enum "false",
                                "true" ;
                            proc:nullable true ;
                            proc:type "boolean" ] ] ] ;
    proc:jobControlOptions "async-execute",
        "dismiss",
        "sync-execute" ;
    proc:mutable false ;
    proc:outputTransmission "reference",
        "value" ;
    proc:outputs [ ns1:TPI [ dcterms:description "Topographic Position Index" ;
                    dcterms:title "Topographic Position Index" ;
                    proc:schema [ ns3:oneOf [ proc:type "string" ;
                                    ns3:contentEncoding "base64" ;
                                    ns3:contentMediaType "image/png" ],
                                [ proc:type "string" ;
                                    ns3:contentEncoding "base64" ;
                                    ns3:contentMediaType "application/x-ogc-envi" ],
                                [ proc:type "string" ;
                                    ns3:contentEncoding "base64" ;
                                    ns3:contentMediaType "application/x-ogc-aaigrid" ],
                                [ proc:type "string" ;
                                    ns3:contentEncoding "base64" ;
                                    ns3:contentMediaType "image/tiff" ] ] ] ] .

