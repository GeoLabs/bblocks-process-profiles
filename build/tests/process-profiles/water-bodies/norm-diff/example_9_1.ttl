<https://geolabs.github.io/bblocks-process-profiles/def/process-type/water-bodies/norm-diff/actions/addition> a rim:RegisterAction ;
    prov:startedAtTime "2026-09-22T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType rim:additionAction ;
    rim:appliesTo <https://geolabs.github.io/bblocks-process-profiles/def/process-type/water-bodies/norm-diff> ;
