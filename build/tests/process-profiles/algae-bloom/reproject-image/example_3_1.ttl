@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <https://w3id.org/ogc/api/schema/> .
@prefix ns2: <http://schema.org/> .
@prefix ns3: <https://w3id.org/geolabs/ospd/process-profiles/input/> .
@prefix pp: <https://w3id.org/geolabs/ospd/process-profiles/> .
@prefix proc: <https://w3id.org/ogc/api/processes/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/geolabs/ospd/process-profiles/process/algae-bloom/reproject-image> dcterms:description "Performs a reprojection over image bands and returns the resulting GeoTiff." ;
    dcterms:subject "OSPD",
        "coverage",
        "demo",
        "raster",
        "reprojection",
        "resampling" ;
    dcterms:title "Performs image reprojection." ;
    pp:version "1.0.0" ;
    proc:inputs [ ns3:input_image [ dcterms:description "" ;
                    dcterms:title "input_image" ;
                    dcterms:type <https://w3id.org/geolabs/ospd/data-types/data-type/raster> ;
                    proc:keywords "raster" ;
                    proc:maxOccurs 1 ;
                    proc:metadata [ dcterms:title "Implementation Profile: Raster resampling -- input `raster`" ;
                            proc:href <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/raster-resampling/inputs/raster> ;
                            proc:role <https://w3id.org/geolabs/ospd/generic-profiles/role/implementation-input> ],
                        [ dcterms:title "Generic Profile: Raster resampling -- input `raster`" ;
                            proc:href <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-resampling/inputs/raster> ;
                            proc:role <https://w3id.org/geolabs/ospd/generic-profiles/role/generic-input> ] ;
                    proc:minOccurs 1 ;
                    proc:schema [ ns1:oneOf [ proc:type "string" ;
                                    ns1:contentEncoding "binary" ;
                                    ns1:contentMediaType "image/tiff" ],
                                [ proc:type "string" ;
                                    ns1:contentEncoding "binary" ;
                                    ns1:contentMediaType "image/tiff; application=geotiff" ],
                                [ proc:type "string" ;
                                    ns1:contentEncoding "binary" ;
                                    ns1:contentMediaType "image/jp2" ] ] ] ;
            ns3:output_dimensions [ dcterms:description "Output dimensions for (width, height) of the output image." ;
                    dcterms:title "output_dimensions" ;
                    proc:maxOccurs 1 ;
                    proc:minOccurs 0 ;
                    proc:schema [ proc:type "array" ;
                            ns1:items [ proc:type "integer" ] ] ] ;
            ns3:output_name [ dcterms:description "Name to apply for the output GeoTiff file." ;
                    dcterms:title "Output file name" ;
                    proc:maxOccurs 1 ;
                    proc:minOccurs 1 ;
                    proc:schema [ proc:type "string" ] ] ;
            ns3:output_resolution [ dcterms:description "Output resolution for (width, height) of the output image." ;
                    dcterms:title "output_resolution" ;
                    dcterms:type <https://w3id.org/geolabs/ospd/data-types/data-type/grid-resolution> ;
                    proc:keywords "grid resolution" ;
                    proc:maxOccurs 1 ;
                    proc:metadata [ dcterms:title "Generic Profile: Raster resampling -- input `resolution`" ;
                            proc:href <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-resampling/inputs/resolution> ;
                            proc:role <https://w3id.org/geolabs/ospd/generic-profiles/role/generic-input> ],
                        [ dcterms:title "Implementation Profile: Raster resampling -- input `resolution`" ;
                            proc:href <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/raster-resampling/inputs/resolution> ;
                            proc:role <https://w3id.org/geolabs/ospd/generic-profiles/role/implementation-input> ] ;
                    proc:minOccurs 0 ;
                    proc:schema [ proc:type "array" ;
                            ns1:items [ proc:type "integer" ] ] ] ] ;
    proc:jobControlOptions "async-execute" ;
    proc:metadata [ rdf:value [ a ns2:Person ;
                    ns2:email "francis.charette-migneault@crim.ca" ;
                    ns2:identifier "http://orcid.org/0000-0003-4862-3349" ;
                    ns2:name "Francis Charette-Migneault" ] ;
            proc:role schema:author ],
        [ rdf:value "1.0.0" ;
            proc:role schema:softwareVersion ],
        [ dcterms:title "Generic Profile: Raster resampling" ;
            proc:href <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-resampling> ;
            proc:role <http://www.opengis.net/spec/wps/2.0/def/process-profile/generic> ],
        [ dcterms:title "Implementation Profile: Raster resampling" ;
            proc:href <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/raster-resampling> ;
            proc:role <http://www.opengis.net/spec/wps/2.0/def/process-profile/implementation> ],
        [ dcterms:title "Process Concept: Raster Coverage Processing" ;
            proc:href <https://w3id.org/geolabs/ospd/generic-profiles/concept/raster-coverage-processing> ;
            proc:role <http://www.opengis.net/spec/wps/2.0/def/process-profile/concept> ],
        [ rdf:value "https://gitlab.ogc.org/ogc/ogc-ospd" ;
            proc:role schema:codeRepository ],
        [ rdf:value "Performs a reprojection over image bands and returns the resulting GeoTiff." ;
            proc:role schema:description ],
        [ rdf:value "https://spdx.org/licenses/CC-BY-NC-SA-4.0" ;
            proc:role schema:license ],
        [ rdf:value "Performs image reprojection." ;
            proc:role schema:name ] ;
    proc:mutable true ;
    proc:outputTransmission "reference",
        "value" ;
    proc:outputs [ pp:result [ dcterms:description "" ;
                    dcterms:title "result" ;
                    dcterms:type <https://w3id.org/geolabs/ospd/data-types/data-type/raster> ;
                    proc:keywords "raster" ;
                    proc:metadata [ dcterms:title "Generic Profile: Raster resampling -- output `raster`" ;
                            proc:href <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-resampling/outputs/raster> ;
                            proc:role <https://w3id.org/geolabs/ospd/generic-profiles/role/generic-output> ],
                        [ dcterms:title "Implementation Profile: Raster resampling -- output `raster`" ;
                            proc:href <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/raster-resampling/outputs/raster> ;
                            proc:role <https://w3id.org/geolabs/ospd/generic-profiles/role/implementation-output> ] ;
                    proc:schema [ proc:type "string" ;
                            ns1:contentEncoding "binary" ;
                            ns1:contentMediaType "image/tiff; application=geotiff" ] ] ] .

