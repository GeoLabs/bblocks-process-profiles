@prefix wfprov: <http://purl.org/wf4ever/wfprov#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ospd.example.org/ogc-api/processes/algae-usecase-workflow-earth-search/package> a prov:Plan ;
    dcterms:license <https://spdx.org/licenses/CC-BY-NC-SA-4.0> ;
    pp:candidateCctDependency "eoap.cct.geojson",
        "eoap.cct.string-format" ;
    pp:cwlClass "Workflow" ;
    pp:cwlId "algae-usecase-workflow-earth-search" ;
    proc:executionUnit [ dcterms:format "application/cwl+yaml" ;
            ns1:relation <http://www.opengis.net/def/rel/ogc/1.0/executionUnit> ;
            oa:hasTarget <https://github.com/crim-ca/ogc-ospd-phase1/raw/5edd4ec4cbd21e5fceb7c3f4b6c5d0ce809a57ea/ogc_app_pkg/algae-usecase-workflow-earth-search.cwl> ] .

<https://w3id.org/geolabs/ospd/process-profiles/process-type/algae-bloom/workflow-earth-search/actions/addition> a rim:RegisterAction ;
    prov:startedAtTime "2026-09-22T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType rim:additionAction ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/process-profiles/process-type/algae-bloom/workflow-earth-search> ;
    rim:proposer pp:geolabs .

<https://w3id.org/geolabs/ospd/process-profiles/process-type/algae-bloom/workflow-earth-search/actions/d5-2026-11-09> a rim:RegisterAction ;
    dcterms:description "Decision D5: the meaning of the type (prefLabel, definition, subClassOf) is kept apart from the rest. The six-phase position moves from skos:broader to pp:phase (classification); profile, processDescription and provenanceClass move to a node of their own (pp:deployment); the openEO correspondences are grouped apart. The plan was already a node of its own." ;
    prov:startedAtTime "2026-11-09T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType pp:amendmentAction ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/process-profiles/process-type/algae-bloom/workflow-earth-search> ;
    rim:changeClassification rim:substantiveChange ;
    rim:proposer pp:geolabs .

<https://w3id.org/geolabs/ospd/process-profiles/process-type/algae-bloom/workflow-earth-search/actions/identifier-2026-11-17> a rim:RegisterAction ;
    dcterms:description "The object identifier of this item moves from https://geolabs.github.io/bblocks-process-profiles/def/process-type/algae-bloom/workflow-earth-search to https://w3id.org/geolabs/ospd/process-profiles/process-type/algae-bloom/workflow-earth-search, which resolves through w3id.org (decision of 2026-11-17); the register actions of the item move with it, under https://w3id.org/geolabs/ospd/process-profiles/process-type/algae-bloom/workflow-earth-search/actions/. The old IRI is kept as owl:sameAs. The content of the item is unchanged. Classified clarifying: the item is the same, only its identifier changes." ;
    prov:startedAtTime "2026-11-17T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType pp:amendmentAction ;
    rim:affectedProperty rim:objectIdentifier ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/process-profiles/process-type/algae-bloom/workflow-earth-search> ;
    rim:changeClassification rim:clarifyingChange ;
    rim:proposer pp:geolabs .

<https://w3id.org/geolabs/ospd/process-profiles/process/algae-bloom/algae-usecase-workflow-earth-search> rdfs:seeAlso <https://ospd.example.org/ogc-api/processes/algae-usecase-workflow-earth-search> ;
    pp:version "2.0.0" .

<https://w3id.org/geolabs/ospd/process-profiles/process-type/algae-bloom/workflow-earth-search> a owl:Class,
        pp:ProcessType,
        acttype:ActivityType ;
    rdfs:subClassOf acttype:ActivityType ;
    owl:sameAs <https://geolabs.github.io/bblocks-process-profiles/def/process-type/algae-bloom/workflow-earth-search> ;
    skos:definition "Searches for Sentinel-2 L2A products on Earth-Search using filtering parameters and performs band calculation on matched Sentinel-2 products to evaluate algae bloom for water quality assessment. For each match, reference bands are downloaded, processed, and returned as output with raw data, color map and plot visualization. Each output file will be named with the ID of the original product to distinguish them in case of multiple matches." ;
    skos:inScheme pp:process-type ;
    skos:prefLabel "Algae bloom for water quality assessment on Sentinel-2 L2A imagery offered by Earth-Search platform." ;
    pp:deployment [ pp:processDescription <https://w3id.org/geolabs/ospd/process-profiles/process/algae-bloom/algae-usecase-workflow-earth-search> ;
            pp:profile "ospd.process-profiles.algae-bloom.workflow-earth-search" ;
            pp:provenanceClass wfprov:WorkflowRun ] ;
    pp:hasStep <https://w3id.org/geolabs/ospd/process-profiles/process-type/algae-bloom/select-products-sentinel2>,
        <https://w3id.org/geolabs/ospd/process-profiles/process-type/algae-bloom/workflow-earth-search-process> ;
    pp:openeoEquivalence [ pp:decomposition ( [ pp:equivalenceLevel "closeMatch" ;
                        pp:openeo "ogc.openeo.processes.cubes.load_collection" ;
                        pp:stage "select_products" ] [ skos:note "openEO has no scatter over products; a collection is loaded as one data cube." ;
                        pp:equivalenceLevel "none" ;
                        pp:stage "process (scatter over urls)" ] ) ;
            pp:equivalenceLevel "none" ;
            pp:rationale "Composite: a CWL Workflow scattering a per-product subworkflow over the product list. The openEO equivalent would be a user-defined process graph, which has no Building Block of its own; the correspondence is carried by the steps." ] ;
    pp:phase <https://w3id.org/geolabs/ospd/process-profiles/phase/data-retrieval>,
        <https://w3id.org/geolabs/ospd/process-profiles/phase/export-aggregation>,
        <https://w3id.org/geolabs/ospd/process-profiles/phase/filter-configuration>,
        <https://w3id.org/geolabs/ospd/process-profiles/phase/pre-processing>,
        <https://w3id.org/geolabs/ospd/process-profiles/phase/scientific-computation>,
        <https://w3id.org/geolabs/ospd/process-profiles/phase/selection-filtering> ;
    pp:plan <https://ospd.example.org/ogc-api/processes/algae-usecase-workflow-earth-search/package> ;
    rim:hasAction <https://w3id.org/geolabs/ospd/process-profiles/process-type/algae-bloom/workflow-earth-search/actions/addition>,
        <https://w3id.org/geolabs/ospd/process-profiles/process-type/algae-bloom/workflow-earth-search/actions/d5-2026-11-09>,
        <https://w3id.org/geolabs/ospd/process-profiles/process-type/algae-bloom/workflow-earth-search/actions/identifier-2026-11-17> ;
    rim:inRegister pp:register ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/geolabs/ospd/process-profiles/process-type/algae-bloom/workflow-earth-search"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:invalid .

