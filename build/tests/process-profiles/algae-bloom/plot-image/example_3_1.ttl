@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <https://w3id.org/ogc/api/schema/> .
@prefix ns2: <https://w3id.org/geolabs/ospd/process-profiles/input/> .
@prefix ns3: <https://w3id.org/geolabs/ospd/generic-profiles/> .
@prefix ns4: <http://schema.org/> .
@prefix ns5: <https://w3id.org/geolabs/ospd/process-profiles/output/> .
@prefix pp: <https://w3id.org/geolabs/ospd/process-profiles/> .
@prefix proc: <https://w3id.org/ogc/api/processes/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <https://schema.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/geolabs/ospd/process-profiles/process/algae-bloom/plot-image> dcterms:description "Applies the specified color mapping with scaled bins to a geospatial image." ;
    dcterms:subject "OSPD",
        "colour map",
        "demo",
        "geospatial",
        "imagery",
        "raster",
        "rendering",
        "visualization" ;
    dcterms:title "Plots an image with colors." ;
    pp:version "1.0.0" ;
    proc:inputs [ ns2:clip_max [ dcterms:description "Clip values above this threshold for color mapping." ;
                    dcterms:title "clip_max" ;
                    proc:maxOccurs 1 ;
                    proc:minOccurs 0 ;
                    proc:schema [ proc:type "number" ] ] ;
            ns2:clip_min [ dcterms:description "Clip values below this threshold for color mapping." ;
                    dcterms:title "clip_min" ;
                    proc:maxOccurs 1 ;
                    proc:minOccurs 0 ;
                    proc:schema [ proc:type "number" ] ] ;
            ns2:color_scale [ dcterms:description """JSON-like array with each item being an array of 2 elements, 
the first for the bin scale value and the second for the RGB color.
Each RGB value can be either a [0-1] floating point or a [0-255] integer.

Example: '[ [0, [0,0,0]], [20, [0,0,255]], [50, [255,100,0]] ]'
""" ;
                    dcterms:title "Color mappings to bin scales to apply to the image." ;
                    dcterms:type <https://w3id.org/geolabs/ospd/data-types/data-type/colour-map> ;
                    proc:keywords "colour map" ;
                    proc:maxOccurs 1 ;
                    proc:metadata [ dcterms:title "Generic Profile: Raster rendering -- input `colourMap`" ;
                            proc:href <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-rendering/inputs/colourMap> ;
                            proc:role <https://w3id.org/geolabs/ospd/generic-profiles/role/generic-input> ],
                        [ dcterms:title "Implementation Profile: Raster rendering -- input `colourMap`" ;
                            proc:href <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/raster-rendering/inputs/colourMap> ;
                            proc:role <https://w3id.org/geolabs/ospd/generic-profiles/role/implementation-input> ] ;
                    proc:minOccurs 1 ;
                    proc:schema [ proc:type "string" ] ] ;
            ns2:input_image [ dcterms:description "Image to map with the colors bins." ;
                    dcterms:title "input_image" ;
                    dcterms:type <https://w3id.org/geolabs/ospd/data-types/data-type/raster> ;
                    ns3:representation <https://w3id.org/geolabs/ospd/data-formats/representation/raster-geotiff>,
                        <https://w3id.org/geolabs/ospd/data-formats/representation/raster-jpeg2000> ;
                    proc:keywords "raster" ;
                    proc:maxOccurs 1 ;
                    proc:metadata [ dcterms:title "Implementation Profile: Raster rendering -- input `raster`" ;
                            proc:href <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/raster-rendering/inputs/raster> ;
                            proc:role <https://w3id.org/geolabs/ospd/generic-profiles/role/implementation-input> ],
                        [ dcterms:title "Generic Profile: Raster rendering -- input `raster`" ;
                            proc:href <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-rendering/inputs/raster> ;
                            proc:role <https://w3id.org/geolabs/ospd/generic-profiles/role/generic-input> ] ;
                    proc:minOccurs 1 ;
                    proc:schema [ ns1:oneOf [ proc:type "string" ;
                                    ns1:contentEncoding "binary" ;
                                    ns1:contentMediaType "image/jp2" ],
                                [ proc:type "string" ;
                                    ns1:contentEncoding "binary" ;
                                    ns1:contentMediaType "image/tiff; application=geotiff" ],
                                [ proc:type "string" ;
                                    ns1:contentEncoding "binary" ;
                                    ns1:contentMediaType "image/tiff" ] ] ] ;
            ns2:output_name [ dcterms:description "" ;
                    dcterms:title "output_name" ;
                    proc:maxOccurs 1 ;
                    proc:minOccurs 0 ;
                    proc:schema [ proc:default "\"output\""^^rdf:JSON ;
                            proc:type "string" ] ] ;
            ns2:plot_name [ dcterms:description "" ;
                    dcterms:title "plot_name" ;
                    proc:maxOccurs 1 ;
                    proc:minOccurs 0 ;
                    proc:schema [ proc:default "\"plot\""^^rdf:JSON ;
                            proc:type "string" ] ] ;
            ns2:plot_title [ dcterms:description "" ;
                    dcterms:title "plot_title" ;
                    proc:maxOccurs 1 ;
                    proc:minOccurs 0 ;
                    proc:schema [ proc:type "string" ] ] ] ;
    proc:jobControlOptions "async-execute" ;
    proc:metadata [ dcterms:title "Generic Profile: Raster rendering" ;
            proc:href <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-rendering> ;
            proc:role <http://www.opengis.net/spec/wps/2.0/def/process-profile/generic> ],
        [ rdf:value "https://gitlab.ogc.org/ogc/ogc-ospd" ;
            proc:role schema:codeRepository ],
        [ rdf:value "https://spdx.org/licenses/CC-BY-NC-SA-4.0" ;
            proc:role schema:license ],
        [ rdf:value "Applies the specified color mapping with scaled bins to a geospatial image." ;
            proc:role schema:description ],
        [ dcterms:title "Process Concept: Raster Coverage Processing" ;
            proc:href <https://w3id.org/geolabs/ospd/generic-profiles/concept/raster-coverage-processing> ;
            proc:role <http://www.opengis.net/spec/wps/2.0/def/process-profile/concept> ],
        [ rdf:value [ a ns4:Person ;
                    ns4:email "francis.charette-migneault@crim.ca" ;
                    ns4:identifier "http://orcid.org/0000-0003-4862-3349" ;
                    ns4:name "Francis Charette-Migneault" ] ;
            proc:role schema:author ],
        [ dcterms:title "Implementation Profile: Raster rendering" ;
            proc:href <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/raster-rendering> ;
            proc:role <http://www.opengis.net/spec/wps/2.0/def/process-profile/implementation> ],
        [ rdf:value "Plots an image with colors." ;
            proc:role schema:name ],
        [ rdf:value "1.0.0" ;
            proc:role schema:softwareVersion ] ;
    proc:mutable true ;
    proc:outputTransmission "reference",
        "value" ;
    proc:outputs [ ns5:output_file [ dcterms:description "" ;
                    dcterms:title "output_file" ;
                    dcterms:type <https://w3id.org/geolabs/ospd/data-types/data-type/raster> ;
                    ns3:representation <https://w3id.org/geolabs/ospd/data-formats/representation/raster-geotiff> ;
                    proc:schema [ proc:type "string" ;
                            ns1:contentEncoding "binary" ;
                            ns1:contentMediaType "image/tiff; application=geotiff" ] ] ;
            ns5:output_plot [ dcterms:description "" ;
                    dcterms:title "output_plot" ;
                    dcterms:type <https://w3id.org/geolabs/ospd/data-types/data-type/rendered-image> ;
                    ns3:representation <https://w3id.org/geolabs/ospd/data-formats/representation/rendered-image-png> ;
                    proc:keywords "image" ;
                    proc:metadata [ dcterms:title "Implementation Profile: Raster rendering -- output `image`" ;
                            proc:href <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/raster-rendering/outputs/image> ;
                            proc:role <https://w3id.org/geolabs/ospd/generic-profiles/role/implementation-output> ],
                        [ dcterms:title "Generic Profile: Raster rendering -- output `image`" ;
                            proc:href <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-rendering/outputs/image> ;
                            proc:role <https://w3id.org/geolabs/ospd/generic-profiles/role/generic-output> ] ;
                    proc:schema [ proc:type "string" ;
                            ns1:contentEncoding "binary" ;
                            ns1:contentMediaType "image/png" ] ] ] .

