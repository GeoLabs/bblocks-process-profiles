<https://w3id.org/geolabs/ospd/process-profiles/process/algae-bloom/download-band-sentinel2-stac-item> rdfs:seeAlso <https://ospd.example.org/ogc-api/processes/download-band-sentinel2-stac-item> ;
    pp:version "1.1.0" .

<https://w3id.org/geolabs/ospd/process-profiles/process-type/algae-bloom/download-band-sentinel2-stac-item> a owl:Class,
        pp:ProcessType,
        acttype:ActivityType ;
    rdfs:subClassOf <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/band-retrieval> ;
    owl:sameAs <https://geolabs.github.io/bblocks-process-profiles/def/process-type/algae-bloom/download-band-sentinel2-stac-item> ;
    skos:closeMatch <https://www.opengis.net/def/bblocks/ogc.openeo.processes.cubes.filter_bands>,
        <https://www.opengis.net/def/bblocks/ogc.openeo.processes.cubes.load_collection> ;
    skos:definition "Downloads the GeoTiff band from the Sentinel-2 product STAC Item using the requested band selection criteria. It is assumed that the referenced STAC Item contains the desired GeoTiff Asset with the 'common band name' associated to the band (see https://github.com/stac-extensions/eo#common-band-names)." ;
    skos:inScheme pp:process-type ;
    skos:prefLabel "Downloads Sentinel-2 GeoTiff from STAC Item." ;
    skos:relatedMatch <https://www.opengis.net/def/bblocks/ogc.openeo.types.band-name>,
        <https://www.opengis.net/def/bblocks/ogc.openeo.types.stac> ;
    pp:byReference [ skos:note "The product is given as the URL of its STAC Item, a string, not as the STAC Item itself." ;
            pp:implements <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/band-retrieval/inputs/product> ;
            pp:liveName "product_url" ;
            pp:side "inputs" ] ;
    pp:deployment [ pp:processDescription <https://w3id.org/geolabs/ospd/process-profiles/process/algae-bloom/download-band-sentinel2-stac-item> ;
            pp:profile "ospd.process-profiles.algae-bloom.download-band-sentinel2-stac-item" ;
            pp:provenanceClass wfprov:ProcessRun ] ;
    pp:implementsProfile <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/band-retrieval> ;
    pp:openeoEquivalence [ pp:equivalenceLevel "closeMatch" ;
            pp:rationale "Retrieves one band of one product: load_collection with `bands` (or filter_bands) over a single-item extent. The closest openEO process, `load_stac`, is only an openEO proposal and out of the register's scope. The band is chosen by Sentinel-2 band id (B01..B12), matched to STAC `eo:common_name` assets inside the tool, where openEO uses collection band names directly." ] ;
    pp:phase <https://w3id.org/geolabs/ospd/process-profiles/phase/data-retrieval> ;
    pp:plan <https://ospd.example.org/ogc-api/processes/download-band-sentinel2-stac-item/package> ;
    pp:unboundRole [ skos:note "no input restricts the area: the whole band of the product is retrieved" ;
            pp:implements <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/band-retrieval/inputs/areaOfInterest> ;
            pp:side "inputs" ] ;
    acttype:generatedEntityType geo:Feature ;
    acttype:usedEntityType geo:Feature ;
    rim:hasAction <https://w3id.org/geolabs/ospd/process-profiles/process-type/algae-bloom/download-band-sentinel2-stac-item/actions/addition>,
        <https://w3id.org/geolabs/ospd/process-profiles/process-type/algae-bloom/download-band-sentinel2-stac-item/actions/by-reference-2026-11-10>,
        <https://w3id.org/geolabs/ospd/process-profiles/process-type/algae-bloom/download-band-sentinel2-stac-item/actions/d5-2026-11-09>,
        <https://w3id.org/geolabs/ospd/process-profiles/process-type/algae-bloom/download-band-sentinel2-stac-item/actions/identifier-2026-11-17>,
        <https://w3id.org/geolabs/ospd/process-profiles/process-type/algae-bloom/download-band-sentinel2-stac-item/actions/inherited-description-2026-11-10>,
        <https://w3id.org/geolabs/ospd/process-profiles/process-type/algae-bloom/download-band-sentinel2-stac-item/actions/representation-2026-11-18>,
        <https://w3id.org/geolabs/ospd/process-profiles/process-type/algae-bloom/download-band-sentinel2-stac-item/actions/specialisation-2026-11-10>,
        <https://w3id.org/geolabs/ospd/process-profiles/process-type/algae-bloom/download-band-sentinel2-stac-item/actions/tier3-2026-11-10>,
        <https://w3id.org/geolabs/ospd/process-profiles/process-type/algae-bloom/download-band-sentinel2-stac-item/actions/unbound-roles-2026-11-10> ;
    rim:inRegister pp:register ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/geolabs/ospd/process-profiles/process-type/algae-bloom/download-band-sentinel2-stac-item"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:invalid .

