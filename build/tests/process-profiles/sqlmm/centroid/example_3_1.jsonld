  ],
  "keywords": [
    "vector",
    "geometry",
    "derived geometry",
    "Centroid"
  ],
  "inputs": {
    "InputPolygon": {
      "title": "Polygon to get the centroid",
      "description": "The centroid which is not necessarily within the geometry.",
      "dataType": "https://w3id.org/geolabs/ospd/data-types/data-type/surface",
      "keywords": [
        "geometry"
      ],
      "metadata": [
        {
          "title": "Generic Profile: Unary geometry operation -- input `geometry`",
          "role": "https://w3id.org/geolabs/ospd/generic-profiles/role/generic-input",
