{
  "@context": "https://geolabs.github.io/bblocks-process-profiles/build/annotated/process-profiles/sqlmm/centroid/context.jsonld",
  "id": "Centroid",
  "title": "Computes the centroid of a polygon. ",
  "description": "This service shall return the point that is the geometric centre of gravity of the geometry InputPolygon.",
  "version": "2.0.0",
  "jobControlOptions": [
    "sync-execute",
    "async-execute",
    "dismiss"
  ],
  "outputTransmission": [
    "value",
    "reference"
  ],
  "mutable": false,
