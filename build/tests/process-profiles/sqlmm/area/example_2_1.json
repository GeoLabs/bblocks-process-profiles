{
  "id": "GetArea",
  "title": "Compute geometry area.",
  "description": "Computes the area of a geometry",
  "version": "2.0.0",
  "jobControlOptions": [
    "sync-execute",
    "async-execute",
    "dismiss"
  ],
  "outputTransmission": [
    "value",
    "reference"
  ],
  "inputs": {
    "InputPolygon": {
      "title": "Polygon to compute are",
      "description": "URI to a set of GML that describes the polygon.",
      "schema": {
        "oneOf": [
          {
            "type": "string",
            "contentEncoding": "UTF-8",
            "contentMediaType": "text/xml",
            "contentSchema": "http://fooa/gml/3.1.0/polygon.xsd"
          },
          {
            "type": "string",
            "contentEncoding": "base64",
            "contentMediaType": "text/xml",
            "contentSchema": "http://fooa/gml/3.1.0/polygon.xsd"
          }
        ]
      },
      "metadata": [
        {
          "title": "Mon test"
        }
      ]
    }
  },
  "outputs": {
    "Area": {
      "title": "Computed Area",
      "description": "The Computed Area Value",
      "schema": {
        "type": "number",
        "format": "float"
      },
      "metadata": [
        {
          "title": "Mon test  "
        }
      ]
    }
  },
  "mutable": false,
  "metadata": [
    {
      "title": "Demo"
    }
  ],
  "links": [
    {
      "rel": "http://www.opengis.net/def/rel/ogc/1.0/execute",
      "type": "application/json",
      "title": "Execute End Point",
      "href": "https://host1.tb.geonovum.geolabs.fr/ogc-api/processes/GetArea/execution"
    }
  ]
}