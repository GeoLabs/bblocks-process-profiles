  ],
  "keywords": [
    "vector",
    "geometry",
    "measure",
    "Area"
  ],
  "inputs": {
    "InputPolygon": {
      "title": "Polygon to compute are",
      "description": "URI to a set of GML that describes the polygon.",
      "dataType": "https://w3id.org/geolabs/ospd/data-types/data-type/surface",
      "representation": [
        "https://w3id.org/geolabs/ospd/data-formats/representation/surface-gml"
      ],
      "keywords": [
        "geometry"
      ],
      "metadata": [
        {
          "title": "Generic Profile: Geometry measure -- input `geometry`",
          "role": "https://w3id.org/geolabs/ospd/generic-profiles/role/generic-input",
          "href": "https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/geometry-measure/inputs/geometry"
        },
        {
