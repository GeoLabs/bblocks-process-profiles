          "href": "https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/area/inputs/geometry"
        },
        {
          "title": "Mon test"
        }
      ],
      "schema": {
        "oneOf": [
          {
            "type": "string",
            "contentEncoding": "UTF-8",
            "contentMediaType": "text/xml",
            "contentSchema": "http://fooa/gml/3.1.0/polygon.xsd"
          },
          {
            "type": "string",
            "contentEncoding": "base64",
            "contentMediaType": "text/xml",
            "contentSchema": "http://fooa/gml/3.1.0/polygon.xsd"
          }
        ]
      }
    }
  },
  "outputs": {
    "Area": {
