<https://w3id.org/geolabs/ospd/process-profiles/process/sqlmm/Crosses> dcterms:description "This service shall return a true value if and only if the geometries g1 and g2 share some but neither is containe in the other, and the dimension of the intersection is less than that of both of the geometries." ;
    dcterms:subject "Crosses",
        "geometry",
        "predicate",
        "spatial relation",
        "vector" ;
    dcterms:title "Crosses test" ;
    rdfs:seeAlso [ rdfs:label "Execute End Point" ;
            dcterms:type "application/json" ;
            ns5:relation <http://www.opengis.net/def/rel/ogc/1.0/execute> ;
            oa:hasTarget <https://host1.tb.geonovum.geolabs.fr/ogc-api/processes/Crosses/execution> ] ;
    pp:version "2.0.0" ;
    proc:inputs [ ns4:InputEntity1 [ dcterms:description "the first geometry." ;
                    dcterms:title "the first geometry" ;
                    dcterms:type <https://w3id.org/geolabs/ospd/data-types/data-type/geometry> ;
                    ns2:representation <https://w3id.org/geolabs/ospd/data-formats/representation/geometry-gml> ;
                    proc:keywords "geometry" ;
                    proc:metadata [ dcterms:title "Generic Profile: Binary spatial predicate -- input `geometry1`" ;
                            proc:href <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/binary-spatial-predicate/inputs/geometry1> ;
                            proc:role <https://w3id.org/geolabs/ospd/generic-profiles/role/generic-input> ],
                        [ dcterms:title "Implementation Profile: Crosses -- input `geometry1`" ;
                            proc:href <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/crosses/inputs/geometry1> ;
                            proc:role <https://w3id.org/geolabs/ospd/generic-profiles/role/implementation-input> ] ;
                    proc:schema [ ns1:oneOf [ proc:type "string" ;
                                    ns1:contentEncoding "base64" ;
                                    ns1:contentMediaType "text/xml" ;
                                    ns1:contentSchema "http://fooa/gml/3.1.0/polygon.xsd" ],
                                [ proc:type "string" ;
                                    ns1:contentEncoding "UTF-8" ;
                                    ns1:contentMediaType "text/xml" ;
                                    ns1:contentSchema "http://fooa/gml/3.1.0/polygon.xsd" ] ] ] ;
            ns4:InputEntity2 [ dcterms:description "the other geometry." ;
                    dcterms:title "the other geometry" ;
                    dcterms:type <https://w3id.org/geolabs/ospd/data-types/data-type/geometry> ;
                    ns2:representation <https://w3id.org/geolabs/ospd/data-formats/representation/geometry-gml> ;
                    proc:keywords "geometry" ;
                    proc:metadata [ dcterms:title "Implementation Profile: Crosses -- input `geometry2`" ;
                            proc:href <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/crosses/inputs/geometry2> ;
                            proc:role <https://w3id.org/geolabs/ospd/generic-profiles/role/implementation-input> ],
                        [ dcterms:title "Generic Profile: Binary spatial predicate -- input `geometry2`" ;
                            proc:href <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/binary-spatial-predicate/inputs/geometry2> ;
                            proc:role <https://w3id.org/geolabs/ospd/generic-profiles/role/generic-input> ] ;
                    proc:schema [ ns1:oneOf [ proc:type "string" ;
                                    ns1:contentEncoding "UTF-8" ;
                                    ns1:contentMediaType "text/xml" ;
                                    ns1:contentSchema "http://fooa/gml/3.1.0/polygon.xsd" ],
                                [ proc:type "string" ;
                                    ns1:contentEncoding "base64" ;
                                    ns1:contentMediaType "text/xml" ;
                                    ns1:contentSchema "http://fooa/gml/3.1.0/polygon.xsd" ] ] ] ] ;
    proc:jobControlOptions "async-execute",
        "dismiss",
        "sync-execute" ;
    proc:metadata [ dcterms:title "Process Concept: Vector Geometry Processing" ;
            proc:href <https://w3id.org/geolabs/ospd/generic-profiles/concept/vector-geometry-processing> ;
            proc:role <http://www.opengis.net/spec/wps/2.0/def/process-profile/concept> ],
        [ dcterms:title "Generic Profile: Binary spatial predicate" ;
            proc:href <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/binary-spatial-predicate> ;
            proc:role <http://www.opengis.net/spec/wps/2.0/def/process-profile/generic> ],
        [ dcterms:title "Implementation Profile: Crosses" ;
            proc:href <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/crosses> ;
            proc:role <http://www.opengis.net/spec/wps/2.0/def/process-profile/implementation> ] ;
    proc:mutable false ;
    proc:outputTransmission "reference",
        "value" ;
    proc:outputs [ ns3:Result [ dcterms:description "true if disjoint." ;
                    dcterms:title "Disjoint result" ;
                    dcterms:type <https://w3id.org/geolabs/ospd/data-types/data-type/boolean> ;
                    proc:keywords "boolean" ;
                    proc:metadata [ dcterms:title "Generic Profile: Binary spatial predicate -- output `result`" ;
                            proc:href <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/binary-spatial-predicate/outputs/result> ;
                            proc:role <https://w3id.org/geolabs/ospd/generic-profiles/role/generic-output> ],
                        [ dcterms:title "Mon test  " ],
                        [ dcterms:title "Implementation Profile: Crosses -- output `result`" ;
                            proc:href <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/crosses/outputs/result> ;
                            proc:role <https://w3id.org/geolabs/ospd/generic-profiles/role/implementation-output> ] ;
                    proc:schema [ proc:type "boolean" ] ] ] .

