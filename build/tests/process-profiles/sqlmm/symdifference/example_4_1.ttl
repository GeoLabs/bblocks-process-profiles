<https://w3id.org/geolabs/ospd/process-profiles/process-type/sqlmm/symdifference/actions/addition> a rim:RegisterAction ;
    prov:startedAtTime "2026-09-22T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType rim:additionAction ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/process-profiles/process-type/sqlmm/symdifference> ;
    rim:proposer pp:geolabs .

<https://w3id.org/geolabs/ospd/process-profiles/process-type/sqlmm/symdifference/actions/d5-2026-11-09> a rim:RegisterAction ;
    dcterms:description "Decision D5: the meaning of the type (prefLabel, definition, subClassOf) is kept apart from the rest. The six-phase position moves from skos:broader to pp:phase (classification); profile, processDescription and provenanceClass move to a node of their own (pp:deployment); the openEO correspondences are grouped apart. The plan was already a node of its own." ;
    prov:startedAtTime "2026-11-09T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType pp:amendmentAction ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/process-profiles/process-type/sqlmm/symdifference> ;
    rim:changeClassification rim:substantiveChange ;
    rim:proposer pp:geolabs .

<https://w3id.org/geolabs/ospd/process-profiles/process-type/sqlmm/symdifference/actions/identifier-2026-11-17> a rim:RegisterAction ;
    dcterms:description "The object identifier of this item moves from https://geolabs.github.io/bblocks-process-profiles/def/process-type/sqlmm/symdifference to https://w3id.org/geolabs/ospd/process-profiles/process-type/sqlmm/symdifference, which resolves through w3id.org (decision of 2026-11-17); the register actions of the item move with it, under https://w3id.org/geolabs/ospd/process-profiles/process-type/sqlmm/symdifference/actions/. The old IRI is kept as owl:sameAs. The content of the item is unchanged. Classified clarifying: the item is the same, only its identifier changes." ;
    prov:startedAtTime "2026-11-17T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType pp:amendmentAction ;
    rim:affectedProperty rim:objectIdentifier ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/process-profiles/process-type/sqlmm/symdifference> ;
    rim:changeClassification rim:clarifyingChange ;
    rim:proposer pp:geolabs .

<https://w3id.org/geolabs/ospd/process-profiles/process-type/sqlmm/symdifference/actions/specialisation-2026-11-10> a rim:RegisterAction ;
    dcterms:description "subClassOf changes from https://w3id.org/ogc/rim/activity-type/ActivityType to https://w3id.org/geolabs/ospd/generic-profiles/activity-type/symdifference, the activity type of the operation in bblocks-generic-profiles (decision of 2026-11-10), with the same entity type(s): http://www.opengis.net/ont/geosparql#Geometry, http://www.opengis.net/ont/geosparql#Geometry." ;
    prov:startedAtTime "2026-11-10T00:00:00+00:00"^^xsd:dateTime ;
    rim:actionType pp:amendmentAction ;
    rim:appliesTo <https://w3id.org/geolabs/ospd/process-profiles/process-type/sqlmm/symdifference> ;
    rim:changeClassification rim:substantiveChange ;
    rim:proposer pp:geolabs .

<https://w3id.org/geolabs/ospd/process-profiles/process/sqlmm/SymDifference> rdfs:seeAlso <https://host1.tb.geonovum.geolabs.fr/ogc-api/processes/SymDifference> ;
    pp:version "2.0.0" .

<https://w3id.org/geolabs/ospd/process-profiles/process-type/sqlmm/symdifference> a owl:Class,
        pp:ProcessType,
        acttype:ActivityType ;
    rdfs:subClassOf <https://w3id.org/geolabs/ospd/generic-profiles/activity-type/symdifference> ;
    owl:sameAs <https://geolabs.github.io/bblocks-process-profiles/def/process-type/sqlmm/symdifference> ;
    skos:definition "This service shall return a feature collection representing the closure of the symmetric difference of two Geometries. The symmetric difference is the set of points which lie on either InputEntity1 or InputEntity2 but not in both." ;
    skos:inScheme pp:process-type ;
    skos:prefLabel "Compute symmetric difference." ;
    pp:deployment [ pp:processDescription <https://w3id.org/geolabs/ospd/process-profiles/process/sqlmm/SymDifference> ;
            pp:profile "ospd.process-profiles.sqlmm.symdifference" ;
            pp:provenanceClass wfprov:ProcessRun ] ;
    pp:implementsProfile <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/symdifference> ;
    pp:openeoEquivalence [ pp:equivalenceLevel "none" ;
            pp:rationale "No openEO process for this SQL/MM set operation in the published bblocks-openeo register." ] ;
    pp:phase <https://w3id.org/geolabs/ospd/process-profiles/phase/scientific-computation> ;
    acttype:generatedEntityType geo:Geometry ;
    acttype:usedEntityType geo:Geometry ;
    rim:hasAction <https://w3id.org/geolabs/ospd/process-profiles/process-type/sqlmm/symdifference/actions/addition>,
        <https://w3id.org/geolabs/ospd/process-profiles/process-type/sqlmm/symdifference/actions/d5-2026-11-09>,
        <https://w3id.org/geolabs/ospd/process-profiles/process-type/sqlmm/symdifference/actions/identifier-2026-11-17>,
        <https://w3id.org/geolabs/ospd/process-profiles/process-type/sqlmm/symdifference/actions/specialisation-2026-11-10> ;
    rim:inRegister pp:register ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://w3id.org/geolabs/ospd/process-profiles/process-type/sqlmm/symdifference"^^xsd:anyURI ;
    rim:publicationStatus rim:published ;
    rim:validityStatus rim:invalid .

