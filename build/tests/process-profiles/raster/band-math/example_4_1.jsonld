    ],
    "openeoEquivalence": {
      "level": "closeMatch",
      "rationale": "Generic band math (muParser expression over an input image list `il`, output forced monoband): the same closeMatch reasoning as W1's `algae-bloom.calculate-band` (also gdal_calc.py-style band math) -- reduce_dimension over the `bands` dimension with a callback built from math processes. The expression is free text here (muParser syntax), a process graph in openEO."
    }
  }
