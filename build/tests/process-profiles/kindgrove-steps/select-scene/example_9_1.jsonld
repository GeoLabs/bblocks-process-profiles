    "processDescription": {
      "id": "select_scene",
      "version": "0.1.0",
      "href": "https://ospd.example.org/ogc-api/processes/select_scene"
    },
    "provenanceClass": "http://purl.org/wf4ever/wfprov#ProcessRun"
  },
  "plan": {
    "id": "https://ospd.example.org/ogc-api/processes/select_scene/package",
    "type": "Plan",
    "executionUnit": {
      "href": "https://github.com/GeoLabs/KindGrove/releases/download/v0.0.2-rc3/mangrove-workflow-steps.cwl#select_scene",
      "type": "application/cwl+yaml",
      "rel": "http://www.opengis.net/def/rel/ogc/1.0/executionUnit"
    },
    "cwlClass": "CommandLineTool",
    "cwlId": "select_scene",
    "license": "https://spdx.org/licenses/CC-BY-NC-SA-4.0",
    "cctDependencies": [],
    "candidateCctDependencies": [
      "eoap.cct.bbox"
    ]
  },
  "implementsProfile": "https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/product-selection",
  "roleDecompositions": [
    {
      "side": "inputs",
      "implements": "https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/product-selection/inputs/areaOfInterest",
      "parts": [
        "west",
        "south",
        "east",
        "north"
      ],
      "note": "The area of interest is taken as the four bounds of a bounding box, in EPSG:4326 (implicit: passed as the `bbox` of pystac_client, read), not as a GeoJSON geometry: the representation geometry-geojson of the role is not served."
    },
    {
      "side": "inputs",
      "implements": "https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/product-selection/inputs/timeInterval",
      "parts": [
        "days_back"
      ],
      "reproducible": false,
      "note": "The time interval is the `days_back` days before the time of execution: the same input gives another interval on another day, so a run cannot be repeated from its inputs alone."
    }
  ],
  "correspondences": {
    "closeMatch": [
      "https://www.opengis.net/def/bblocks/ogc.openeo.processes.cubes.load_collection"
    ],
    "openeoEquivalence": {
      "level": "closeMatch",
      "rationale": "Same filter semantics as load_collection's `spatial_extent` (west/south/east/north) and a `properties` cloud-cover filter; `days_back` is a relative time window resolved against the execution date, not an explicit `temporal_extent` -- the same non-reproducibility already documented for `kindgrove.mangrove-workflow` (Q-W2-DAYSBACK)."
    }
  }
}