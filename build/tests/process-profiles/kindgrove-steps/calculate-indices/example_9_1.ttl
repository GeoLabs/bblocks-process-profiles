<https://geolabs.github.io/bblocks-process-profiles/def/process/calculate_indices> rdfs:seeAlso <https://ospd.example.org/ogc-api/processes/calculate_indices> ;
    pp:version "0.1.0" .

<https://ospd.example.org/ogc-api/processes/calculate_indices/package> a prov:Plan ;
    dcterms:license <https://spdx.org/licenses/CC-BY-NC-SA-4.0> ;
    pp:cwlClass "CommandLineTool" ;
    pp:cwlId "calculate_indices" ;
    proc:executionUnit [ dcterms:format "application/cwl+yaml" ;
            ns1:relation <http://www.opengis.net/def/rel/ogc/1.0/executionUnit> ;
            oa:hasTarget <https://github.com/GeoLabs/KindGrove/releases/download/v0.0.2-rc3/mangrove-workflow-steps.cwl#calculate_indices> ] .

<https://geolabs.github.io/bblocks-process-profiles/def/process-type/kindgrove-steps/calculate-indices> a owl:Class,
        pp:ProcessType,
        acttype:ActivityType ;
    rdfs:subClassOf <https://geolabs.github.io/bblocks-generic-profiles/def/activity-type/radiometric-index> ;
    skos:definition "Computes NDVI, NDWI and SAVI from Sentinel-2 red, green and NIR bands." ;
    skos:inScheme pp:process-type ;
    skos:prefLabel "Compute NDVI, NDWI and SAVI" ;
    pp:deployment [ pp:processDescription <https://geolabs.github.io/bblocks-process-profiles/def/process/calculate_indices> ;
            pp:profile "ospd.process-profiles.kindgrove-steps.calculate-indices" ;
            pp:provenanceClass wfprov:ProcessRun ] ;
    pp:fixedRoleValue [ rdf:value "NDVI",
                "NDWI",
                "SAVI" ;
            skos:note "computed by the notebook steps/04_calculate_indices.ipynb, one output each, in this order" ;
            pp:implements <https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/radiometric-index-single-band/inputs/index> ;
            pp:side "inputs" ] ;
    pp:implementsProfile <https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/radiometric-index-single-band> ;
    pp:openeoEquivalence [ pp:decomposition ( [ pp:equivalenceLevel "closeMatch" ;
                        pp:openeo "ogc.openeo.processes.cubes.ndvi" ;
                        pp:stage "ndvi" ] [ pp:equivalenceLevel "closeMatch" ;
                        pp:openeo "ogc.openeo.processes.math.indices.normalized_difference" ;
                        pp:stage "ndwi" ] [ skos:note "soil-adjusted vegetation index, no openEO process in this register" ;
                        pp:equivalenceLevel "none" ;
                        pp:stage "savi" ] ) ;
            pp:equivalenceLevel "none" ;
            pp:rationale "Composite, one tool computing three indices from the same three-band input at once. NDVI alone would be closeMatch `ogc.openeo.processes.cubes.ndvi`; NDWI alone closeMatch `ogc.openeo.processes.math.indices.normalized_difference` (as in `water-bodies.norm-diff` and `kindgrove.mangrove`); SAVI (soil-adjusted, not a plain normalized difference) has no openEO process in this register. Kept `none` for the tool as a whole since no single openEO process covers the composite." ] ;
    pp:phase <https://geolabs.github.io/bblocks-process-profiles/def/phase/scientific-computation> ;
    pp:plan <https://ospd.example.org/ogc-api/processes/calculate_indices/package> ;
    pp:unboundRole [ skos:note "no input selects the indices: the tool always computes NDVI, NDWI and SAVI" ;
            pp:implements <https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/radiometric-index-single-band/inputs/index> ;
            pp:side "inputs" ] ;
    acttype:generatedEntityType geo:Feature ;
    acttype:usedEntityType geo:Feature ;
    rim:hasAction <https://geolabs.github.io/bblocks-process-profiles/def/process-type/kindgrove-steps/calculate-indices/actions/addition>,
        <https://geolabs.github.io/bblocks-process-profiles/def/process-type/kindgrove-steps/calculate-indices/actions/d5-2026-11-09>,
        <https://geolabs.github.io/bblocks-process-profiles/def/process-type/kindgrove-steps/calculate-indices/actions/fixed-role-values-2026-11-10>,
        <https://geolabs.github.io/bblocks-process-profiles/def/process-type/kindgrove-steps/calculate-indices/actions/inherited-description-2026-11-10>,
        <https://geolabs.github.io/bblocks-process-profiles/def/process-type/kindgrove-steps/calculate-indices/actions/plan-2026-11-11>,
        <https://geolabs.github.io/bblocks-process-profiles/def/process-type/kindgrove-steps/calculate-indices/actions/specialisation-2026-11-10>,
        <https://geolabs.github.io/bblocks-process-profiles/def/process-type/kindgrove-steps/calculate-indices/actions/tier3-2026-11-10>,
        <https://geolabs.github.io/bblocks-process-profiles/def/process-type/kindgrove-steps/calculate-indices/actions/unbound-roles-2026-11-10> ;
    rim:inRegister pp:register ;
    rim:itemClass acttype:activityTypeItemClass ;
    rim:objectIdentifier "https://geolabs.github.io/bblocks-process-profiles/def/process-type/kindgrove-steps/calculate-indices"^^xsd:anyURI ;
