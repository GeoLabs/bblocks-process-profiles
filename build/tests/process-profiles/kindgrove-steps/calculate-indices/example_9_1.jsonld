    }
  ],
  "fixedRoleValues": [
    {
      "side": "inputs",
      "implements": "https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/radiometric-index-single-band/inputs/index",
      "values": [
        "NDVI",
        "NDWI",
        "SAVI"
      ],
      "reason": "computed by the notebook steps/04_calculate_indices.ipynb, one output each, in this order"
    }
  ],
  "correspondences": {
    "openeoEquivalence": {
      "level": "none",
      "rationale": "Composite, one tool computing three indices from the same three-band input at once. NDVI alone would be closeMatch `ogc.openeo.processes.cubes.ndvi`; NDWI alone closeMatch `ogc.openeo.processes.math.indices.normalized_difference` (as in `water-bodies.norm-diff` and `kindgrove.mangrove`); SAVI (soil-adjusted, not a plain normalized difference) has no openEO process in this register. Kept `none` for the tool as a whole since no single openEO process covers the composite.",
      "decomposition": [
        {
          "stage": "ndvi",
          "openeo": [
            "ogc.openeo.processes.cubes.ndvi"
          ],
          "level": "closeMatch"
        },
        {
          "stage": "ndwi",
          "openeo": [
            "ogc.openeo.processes.math.indices.normalized_difference"
          ],
          "level": "closeMatch"
        },
        {
          "stage": "savi",
          "openeo": [],
          "level": "none",
          "note": "soil-adjusted vegetation index, no openEO process in this register"
        }
      ]
    }
  }
