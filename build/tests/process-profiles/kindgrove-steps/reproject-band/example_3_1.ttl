<https://w3id.org/geolabs/ospd/process-profiles/process/kindgrove-steps/reproject_band> dcterms:description "Process converted from CWL" ;
    dcterms:subject "coverage",
        "mangrove",
        "ospd",
        "raster",
        "reprojection" ;
    dcterms:title "reproject_band" ;
    pp:version "0.1.0" ;
    proc:inputs [ ns4:band_file [ dcterms:description "" ;
                    dcterms:title "band_file" ;
                    dcterms:type <https://w3id.org/geolabs/ospd/data-types/data-type/raster> ;
                    ns5:representation <https://w3id.org/geolabs/ospd/data-formats/representation/raster-geotiff> ;
                    proc:keywords "raster" ;
                    proc:maxOccurs 1 ;
                    proc:metadata [ dcterms:title "Implementation Profile: Raster reprojection -- input `raster`" ;
                            proc:href <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/raster-reprojection/inputs/raster> ;
                            proc:role <https://w3id.org/geolabs/ospd/generic-profiles/role/implementation-input> ],
                        [ dcterms:title "Generic Profile: Raster reprojection -- input `raster`" ;
                            proc:href <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-reprojection/inputs/raster> ;
                            proc:role <https://w3id.org/geolabs/ospd/generic-profiles/role/generic-input> ] ;
                    proc:minOccurs 1 ;
                    proc:schema [ proc:type "string" ;
                            ns3:contentEncoding "binary" ;
                            ns3:contentMediaType "image/tiff; application=geotiff" ] ] ;
            ns4:east [ dcterms:description "" ;
                    dcterms:title "east" ;
                    proc:maxOccurs 1 ;
                    proc:minOccurs 1 ;
                    proc:schema [ proc:type "number" ] ] ;
            ns4:epsg [ dcterms:description "" ;
                    dcterms:title "epsg" ;
                    dcterms:type <https://w3id.org/geolabs/ospd/data-types/data-type/coordinate-reference-system> ;
                    proc:keywords "CRS" ;
                    proc:maxOccurs 1 ;
                    proc:metadata [ dcterms:title "Generic Profile: Raster reprojection -- input `targetCRS`" ;
                            proc:href <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-reprojection/inputs/targetCRS> ;
                            proc:role <https://w3id.org/geolabs/ospd/generic-profiles/role/generic-input> ],
                        [ dcterms:title "Implementation Profile: Raster reprojection -- input `targetCRS`" ;
                            proc:href <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/raster-reprojection/inputs/targetCRS> ;
                            proc:role <https://w3id.org/geolabs/ospd/generic-profiles/role/implementation-input> ] ;
                    proc:minOccurs 0 ;
                    proc:schema [ proc:default "4326"^^rdf:JSON ;
                            proc:type "integer" ] ] ;
            ns4:north [ dcterms:description "" ;
                    dcterms:title "north" ;
                    proc:maxOccurs 1 ;
                    proc:minOccurs 1 ;
                    proc:schema [ proc:type "number" ] ] ;
            ns4:resolution [ dcterms:description "" ;
                    dcterms:title "resolution" ;
                    proc:maxOccurs 1 ;
                    proc:minOccurs 0 ;
                    proc:schema [ proc:default "0.0001"^^rdf:JSON ;
                            proc:type "number" ] ] ;
            ns4:south [ dcterms:description "" ;
                    dcterms:title "south" ;
                    proc:maxOccurs 1 ;
                    proc:minOccurs 1 ;
                    proc:schema [ proc:type "number" ] ] ;
            ns4:west [ dcterms:description "" ;
                    dcterms:title "west" ;
                    proc:maxOccurs 1 ;
                    proc:minOccurs 1 ;
                    proc:schema [ proc:type "number" ] ] ] ;
    proc:jobControlOptions "async-execute" ;
    proc:metadata [ dcterms:title "Process Concept: Raster Coverage Processing" ;
            proc:href <https://w3id.org/geolabs/ospd/generic-profiles/concept/raster-coverage-processing> ;
            proc:role <http://www.opengis.net/spec/wps/2.0/def/process-profile/concept> ],
        [ dcterms:title "Generic Profile: Raster reprojection" ;
            proc:href <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-reprojection> ;
            proc:role <http://www.opengis.net/spec/wps/2.0/def/process-profile/generic> ],
        [ dcterms:title "Implementation Profile: Raster reprojection" ;
            proc:href <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/raster-reprojection> ;
            proc:role <http://www.opengis.net/spec/wps/2.0/def/process-profile/implementation> ],
        [ rdf:value "https://github.com/starling-foundries/KindGrove" ;
            proc:role schema:codeRepository ],
        [ rdf:value "0.1.0" ;
            proc:role schema:softwareVersion ],
        [ rdf:value "Reproject a raster onto a regular grid covering a bounding box" ;
            proc:role schema:description ],
        [ rdf:value [ a ns1:Person ;
                    ns1:name "Cameron Sajedi" ] ;
            proc:role schema:author ],
        [ rdf:value [ a ns1:Person ;
                    ns1:affiliation "GeoLabs" ;
                    ns1:name "Gérald Fenoy" ] ;
            proc:role schema:contributor ],
        [ rdf:value "reproject_band" ;
            proc:role schema:name ],
        [ rdf:value "https://spdx.org/licenses/CC-BY-NC-SA-4.0" ;
            proc:role schema:license ] ;
    proc:mutable true ;
    proc:outputTransmission "reference",
        "value" ;
    proc:outputs [ ns2:reprojected_file [ dcterms:description "" ;
                    dcterms:title "reprojected_file" ;
                    dcterms:type <https://w3id.org/geolabs/ospd/data-types/data-type/raster> ;
                    ns5:representation <https://w3id.org/geolabs/ospd/data-formats/representation/raster-geotiff> ;
                    proc:keywords "raster" ;
                    proc:metadata [ dcterms:title "Implementation Profile: Raster reprojection -- output `raster`" ;
                            proc:href <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/raster-reprojection/outputs/raster> ;
                            proc:role <https://w3id.org/geolabs/ospd/generic-profiles/role/implementation-output> ],
                        [ dcterms:title "Generic Profile: Raster reprojection -- output `raster`" ;
                            proc:href <https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/raster-reprojection/outputs/raster> ;
                            proc:role <https://w3id.org/geolabs/ospd/generic-profiles/role/generic-output> ] ;
                    proc:schema [ proc:type "string" ;
                            ns3:contentEncoding "binary" ;
                            ns3:contentMediaType "image/tiff; application=geotiff" ] ] ] .

