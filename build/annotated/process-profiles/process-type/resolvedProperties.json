{"defs":{},"properties":[{"path":["id"],"id":"@id","description":"IRI of the process type (also used as `activityType` in provenance records).","required":true,"schema_type":"string","format":"uri","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"@id"},{"path":["type"],"id":"@type","required":true,"const":"ProcessType","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"@type"},{"path":["prefLabel"],"id":"http://www.w3.org/2004/02/skos/core#prefLabel","required":true,"schema_type":"string","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"http://www.w3.org/2004/02/skos/core#prefLabel"},{"path":["definition"],"id":"http://www.w3.org/2004/02/skos/core#definition","required":true,"schema_type":"string","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"http://www.w3.org/2004/02/skos/core#definition"},{"path":["inScheme"],"id":"http://www.w3.org/2004/02/skos/core#inScheme","jsonld_type":"@id","description":"IRI of the process-type register (concept scheme) this entry is proposed to.","required":true,"schema_type":"string","format":"uri","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"http://www.w3.org/2004/02/skos/core#inScheme"},{"path":["status"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/status","description":"ISO 19135 item status. Entries produced here are candidates, hence `submitted` at most.","required":true,"schema_type":"string","enum":["submitted","valid","invalid","superseded","retired"],"sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/status"},{"path":["phase"],"id":"http://www.w3.org/2004/02/skos/core#broader","jsonld_type":"@id","description":"Position(s) in the six-phase workflow framework.","required":true,"schema_type":"array","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"http://www.w3.org/2004/02/skos/core#broader"},{"path":["profile"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/profile","description":"Identifier of the process-profile Building Block.","required":true,"schema_type":"string","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/profile"},{"path":["processDescription"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/processDescription","description":"The OGC API - Processes processDescription this type is profiled from, at `href` (the `/processes/{processID}` resource). For a CWL-sourced process it is the description the Application Package would deploy, under the illustrative host `ospd.example.org`; for a live process (e.g. a ZOO-Project deployment, `ospd.process-profiles.sqlmm.*`) the real one.","required":true,"schema_type":"object","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/processDescription"},{"path":["processDescription","id"],"id":"@id","required":true,"schema_type":"string","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"@id"},{"path":["processDescription","version"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/version","required":true,"schema_type":"string","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/version"},{"path":["processDescription","href"],"id":"http://www.w3.org/2000/01/rdf-schema#seeAlso","jsonld_type":"@id","required":true,"schema_type":"string","format":"uri","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"http://www.w3.org/2000/01/rdf-schema#seeAlso"},{"path":["processDescription","license"],"id":"http://purl.org/dc/terms/license","jsonld_type":"@id","description":"Of a live process; omitted, not null, when it declares none -- do not assume one.","schema_type":"string","format":"uri","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"http://purl.org/dc/terms/license"},{"path":["plan"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/plan","description":"The plan (`prov:Plan`) an activity of this type executes: the OGC Application Package at `/processes/{processID}/package` (OGC API - Processes - Part 2, requirement /req/deploy-replace-undeploy/package-get-op), whose `executionUnit` is the pinned CWL. Present only for a CWL-sourced process.","schema_type":"object","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/plan"},{"path":["plan","id"],"id":"@id","required":true,"schema_type":"string","format":"uri","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"@id"},{"path":["plan","type"],"id":"@type","required":true,"const":"Plan","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"@type"},{"path":["plan","executionUnit"],"id":"https://w3id.org/ogc/api/processes/executionUnit","description":"Same link as the Application Package's own `executionUnit` (examples/ogcapppkg.json).","required":true,"schema_type":"object","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://w3id.org/ogc/api/processes/executionUnit"},{"path":["plan","executionUnit","href"],"id":"http://www.w3.org/ns/oa#hasTarget","jsonld_type":"@id","description":"Pinned URL of the CWL document.","required":true,"schema_type":"string","format":"uri","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"http://www.w3.org/ns/oa#hasTarget"},{"path":["plan","executionUnit","type"],"id":"http://purl.org/dc/terms/format","required":true,"schema_type":"string","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"http://purl.org/dc/terms/format"},{"path":["plan","executionUnit","rel"],"id":"http://www.iana.org/assignments/relation","jsonld_type":"@id","schema_type":"string","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"http://www.iana.org/assignments/relation"},{"path":["plan","cwlClass"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/cwlClass","required":true,"enum":["CommandLineTool","Workflow","ExpressionTool"],"sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/cwlClass"},{"path":["plan","cwlId"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/cwlId","required":true,"schema_type":"string","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/cwlId"},{"path":["plan","license"],"id":"http://purl.org/dc/terms/license","jsonld_type":"@id","schema_type":"string","format":"uri","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"http://purl.org/dc/terms/license"},{"path":["plan","cctDependencies"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/cctDependency","description":"EOAP CWL custom types used by the CWL.","schema_type":"array","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/cctDependency"},{"path":["plan","candidateCctDependencies"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/candidateCctDependency","description":"EOAP CWL custom types that could replace plain CWL types (not used by the CWL).","schema_type":"array","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/candidateCctDependency"},{"path":["provenanceClass"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/provenanceClass","jsonld_type":"@id","description":"Class of the run records produced by executing this process.","required":true,"schema_type":"string","enum":["http://purl.org/wf4ever/wfprov#ProcessRun","http://purl.org/wf4ever/wfprov#WorkflowRun"],"sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/provenanceClass"},{"path":["implementsProfile"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/implementsProfile","jsonld_type":"@id","description":"IRI of the nearest applicable profile this process specialises, in the generic-profiles register -- normally an Implementation Profile (generic-profiles.implementation-profile.*, OGC 14-065 WPS 2.0.2 \u00a77.5.3: standard data formats, still not one specific deployment's own choice), or a Generic Profile directly when no Implementation Profile exists yet. Optional: most processes have no standardised abstract counterpart at all. `processDescription` and `plan` (this entry's own concrete binding) are what further specialise it to one real, deployed process -- Implementation (instance level) in the same standard's terms.","schema_type":"string","format":"uri","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/implementsProfile"},{"path":["hasStep"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/hasStep","jsonld_type":"@id","description":"Process types of the steps of a Workflow.","schema_type":"array","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/hasStep"},{"path":["exactMatch"],"id":"http://www.w3.org/2004/02/skos/core#exactMatch","jsonld_type":"@id","schema_type":"array","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"http://www.w3.org/2004/02/skos/core#exactMatch"},{"path":["closeMatch"],"id":"http://www.w3.org/2004/02/skos/core#closeMatch","jsonld_type":"@id","schema_type":"array","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"http://www.w3.org/2004/02/skos/core#closeMatch"},{"path":["relatedMatch"],"id":"http://www.w3.org/2004/02/skos/core#relatedMatch","jsonld_type":"@id","schema_type":"array","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"http://www.w3.org/2004/02/skos/core#relatedMatch"},{"path":["openeoEquivalence"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/openeoEquivalence","required":true,"schema_type":"object","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/openeoEquivalence"},{"path":["openeoEquivalence","level"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/equivalenceLevel","required":true,"enum":["exactMatch","closeMatch","none"],"sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/equivalenceLevel"},{"path":["openeoEquivalence","rationale"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/rationale","required":true,"schema_type":"string","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/rationale"},{"path":["openeoEquivalence","decomposition"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/decomposition","description":"Ordered correspondence of the stages of a composite or opaque process.","schema_type":"array","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/decomposition"},{"path":["openeoEquivalence","decomposition","stage"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/stage","required":true,"schema_type":"string","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/stage"},{"path":["openeoEquivalence","decomposition","openeo"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/openeo","schema_type":"array","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/openeo"},{"path":["openeoEquivalence","decomposition","level"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/equivalenceLevel","required":true,"enum":["exactMatch","closeMatch","none"],"sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/equivalenceLevel"},{"path":["openeoEquivalence","decomposition","note"],"id":"http://www.w3.org/2004/02/skos/core#note","schema_type":"string","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"http://www.w3.org/2004/02/skos/core#note"}]}