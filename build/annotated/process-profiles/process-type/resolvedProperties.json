{"defs":{"0":[{"path":["id"],"id":"@id","required":true,"schema_type":"string","format":"uri","sources":["bblocks://ogc.rim.schemas.register-item"],"effectiveId":"@id"}]},"properties":[{"path":["id"],"id":"@id","description":"IRI of the process type (also used as `activityType` in provenance records).","required":true,"schema_type":"string","format":"uri","sources":["bblocks://ogc.rim.schemas.register-item","bblocks://ospd.process-profiles.process-type"],"effectiveId":"@id"},{"path":["type"],"id":"@type","description":"rim:RegisterItem, or a sub-register's own term for a sub-class of it.","required":true,"const":["ProcessType","owlClass","ActivityType"],"sources":["bblocks://ogc.rim.schemas.register-item","bblocks://ospd.process-profiles.process-type"],"effectiveId":"@type"},{"path":["objectIdentifier"],"id":"https://w3id.org/ogc/rim/objectIdentifier","jsonld_type":"http://www.w3.org/2001/XMLSchema#anyURI","description":"Permanently bound to this item; never redirects.","required":true,"schema_type":"string","format":"uri","sources":["bblocks://ogc.rim.schemas.register-item","bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://w3id.org/ogc/rim/objectIdentifier"},{"path":["functionalIdentifier"],"id":"https://w3id.org/ogc/rim/functionalIdentifier","jsonld_type":"http://www.w3.org/2001/XMLSchema#anyURI","description":"Redirectable identifier serving a stable intent (e.g. \"the current version\").","schema_type":"string","format":"uri","sources":["bblocks://ogc.rim.schemas.register-item"],"effectiveId":"https://w3id.org/ogc/rim/functionalIdentifier"},{"path":["itemClass"],"id":"https://w3id.org/ogc/rim/itemClass","jsonld_type":"@id","description":"The item's one rim:RegisterItemClass (an IRI or an embedded node).","required":true,"const":"https://w3id.org/ogc/rim/activity-type/activityTypeItemClass","sources":["bblocks://ogc.rim.schemas.register-item","bblocks://ospd.process-profiles.process-type"],"ref":"0","effectiveId":"https://w3id.org/ogc/rim/itemClass"},{"path":["inRegister"],"id":"https://w3id.org/ogc/rim/inRegister","jsonld_type":"@id","required":true,"const":"https://geolabs.github.io/bblocks-process-profiles/def/register","sources":["bblocks://ogc.rim.schemas.register-item","bblocks://ospd.process-profiles.process-type"],"ref":"0","effectiveId":"https://w3id.org/ogc/rim/inRegister"},{"path":["realizes"],"id":"https://w3id.org/ogc/rim/realizes","jsonld_type":"@id","description":"The rim:ConceptVersion this item represents, where the register has a concept plane.","sources":["bblocks://ogc.rim.schemas.register-item"],"ref":"0","effectiveId":"https://w3id.org/ogc/rim/realizes"},{"path":["validityStatus"],"id":"https://w3id.org/ogc/rim/validityStatus","jsonld_type":"@vocab","required":true,"enum":["valid","invalid"],"sources":["bblocks://ogc.rim.schemas.register-item","bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://w3id.org/ogc/rim/validityStatus"},{"path":["publicationStatus"],"id":"https://w3id.org/ogc/rim/publicationStatus","jsonld_type":"@vocab","required":true,"enum":["published","unpublished"],"sources":["bblocks://ogc.rim.schemas.register-item","bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://w3id.org/ogc/rim/publicationStatus"},{"path":["isRedacted"],"id":"https://w3id.org/ogc/rim/isRedacted","jsonld_type":"http://www.w3.org/2001/XMLSchema#boolean","schema_type":"boolean","sources":["bblocks://ogc.rim.schemas.register-item"],"effectiveId":"https://w3id.org/ogc/rim/isRedacted"},{"path":["isDeleted"],"id":"https://w3id.org/ogc/rim/isDeleted","jsonld_type":"http://www.w3.org/2001/XMLSchema#boolean","schema_type":"boolean","sources":["bblocks://ogc.rim.schemas.register-item"],"effectiveId":"https://w3id.org/ogc/rim/isDeleted"},{"path":["title"],"id":"http://purl.org/dc/terms/title","schema_type":"string","sources":["bblocks://ogc.rim.schemas.register-item"],"effectiveId":"http://purl.org/dc/terms/title"},{"path":["description"],"id":"http://purl.org/dc/terms/description","schema_type":"string","sources":["bblocks://ogc.rim.schemas.register-item"],"effectiveId":"http://purl.org/dc/terms/description"},{"path":["relatedItem"],"id":"https://w3id.org/ogc/rim/relatedItem","jsonld_type":"@id","sources":["bblocks://ogc.rim.schemas.register-item"],"effectiveId":"https://w3id.org/ogc/rim/relatedItem"},{"path":["supersededBy"],"id":"https://w3id.org/ogc/rim/supersededBy","jsonld_type":"@id","sources":["bblocks://ogc.rim.schemas.register-item"],"effectiveId":"https://w3id.org/ogc/rim/supersededBy"},{"path":["supersedes"],"id":"https://w3id.org/ogc/rim/supersedes","jsonld_type":"@id","sources":["bblocks://ogc.rim.schemas.register-item"],"effectiveId":"https://w3id.org/ogc/rim/supersedes"},{"path":["hasAction"],"id":"https://w3id.org/ogc/rim/hasAction","jsonld_type":"@id","description":"The register actions of the entry: its addition, then each in-place amendment of the proposal (pp:amendmentAction, pp:specification). The schema requires the addition; it does not constrain the action type or the classification of the other actions (decision Q5, option b, of 2026-11-11: pending a decision common to all registers).","required":true,"schema_type":"array","sources":["bblocks://ogc.rim.schemas.register-item","bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://w3id.org/ogc/rim/hasAction"},{"path":["usedEntityType"],"id":"https://w3id.org/ogc/rim/activity-type/usedEntityType","jsonld_type":"@id","description":"A type of prov:Entity that activities of this type use (prov:used) \u2014 for example a type of input dataset.","schema_type":"string","format":"uri","sources":["bblocks://ogc.register.schemas.activity-types-schema","bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://w3id.org/ogc/rim/activity-type/usedEntityType"},{"path":["generatedEntityType"],"id":"https://w3id.org/ogc/rim/activity-type/generatedEntityType","jsonld_type":"@id","description":"A type of prov:Entity that activities of this type generate (prov:generated) \u2014 for example a type of output product.","schema_type":"string","format":"uri","sources":["bblocks://ogc.register.schemas.activity-types-schema","bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://w3id.org/ogc/rim/activity-type/generatedEntityType"},{"path":["associatedAgentType"],"id":"https://w3id.org/ogc/rim/activity-type/associatedAgentType","jsonld_type":"@id","description":"A type of prov:Agent (for example prov:Person, prov:SoftwareAgent, or a narrower role-bearing type) that activities of this type are associated with (prov:wasAssociatedWith).","schema_type":"string","format":"uri","sources":["bblocks://ogc.register.schemas.activity-types-schema"],"effectiveId":"https://w3id.org/ogc/rim/activity-type/associatedAgentType"},{"path":["informedByActivityType"],"id":"https://w3id.org/ogc/rim/activity-type/informedByActivityType","jsonld_type":"@id","description":"A type of acttype:ActivityType whose instances typically inform activities of this type (prov:wasInformedBy) \u2014 for example an upstream preparation activity type.","schema_type":"string","format":"uri","sources":["bblocks://ogc.register.schemas.activity-types-schema"],"effectiveId":"https://w3id.org/ogc/rim/activity-type/informedByActivityType"},{"path":["_then"],"sources":["bblocks://ospd.process-profiles.process-type"],"keyword":"then"},{"path":["prefLabel"],"id":"http://www.w3.org/2004/02/skos/core#prefLabel","required":true,"schema_type":"string","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"http://www.w3.org/2004/02/skos/core#prefLabel"},{"path":["definition"],"id":"http://www.w3.org/2004/02/skos/core#definition","required":true,"schema_type":"string","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"http://www.w3.org/2004/02/skos/core#definition"},{"path":["inScheme"],"id":"http://www.w3.org/2004/02/skos/core#inScheme","jsonld_type":"@id","description":"IRI of the process-type register (concept scheme) this entry is proposed to.","required":true,"schema_type":"string","format":"uri","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"http://www.w3.org/2004/02/skos/core#inScheme"},{"path":["classification"],"id":"@nest","description":"Classification of the type, apart from its meaning (decision D5). `phase` (pp:phase, formerly skos:broader) is a separate axis from the Process Concepts of bblocks-generic-profiles: see the block description.","required":true,"schema_type":"object","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"@nest"},{"path":["classification","phase"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/phase","jsonld_type":"@id","description":"Position(s) in the six-phase workflow framework.","required":true,"schema_type":"array","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/phase"},{"path":["deployment"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/deployment","description":"What is deployed (decision D5): the process profile block, the processDescription and the class of its run records.","required":true,"schema_type":"object","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/deployment"},{"path":["deployment","profile"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/profile","description":"Identifier of the process-profile Building Block.","required":true,"schema_type":"string","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/profile"},{"path":["deployment","processDescription"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/processDescription","description":"The OGC API - Processes processDescription this type is profiled from, at `href` (the `/processes/{processID}` resource). For a CWL-sourced process it is the description the Application Package would deploy, under the illustrative host `ospd.example.org`; for a live process (e.g. a ZOO-Project deployment, `ospd.process-profiles.sqlmm.*`) the real one.","required":true,"schema_type":"object","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/processDescription"},{"path":["deployment","processDescription","id"],"id":"@id","required":true,"schema_type":"string","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"@id"},{"path":["deployment","processDescription","version"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/version","required":true,"schema_type":"string","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/version"},{"path":["deployment","processDescription","href"],"id":"http://www.w3.org/2000/01/rdf-schema#seeAlso","jsonld_type":"@id","required":true,"schema_type":"string","format":"uri","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"http://www.w3.org/2000/01/rdf-schema#seeAlso"},{"path":["deployment","processDescription","license"],"id":"http://purl.org/dc/terms/license","jsonld_type":"@id","description":"Of a live process; omitted, not null, when it declares none -- do not assume one.","schema_type":"string","format":"uri","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"http://purl.org/dc/terms/license"},{"path":["deployment","provenanceClass"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/provenanceClass","jsonld_type":"@id","description":"Class of the run records produced by executing this process.","required":true,"schema_type":"string","enum":["http://purl.org/wf4ever/wfprov#ProcessRun","http://purl.org/wf4ever/wfprov#WorkflowRun"],"sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/provenanceClass"},{"path":["plan"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/plan","description":"The plan (`prov:Plan`) an activity of this type executes: the OGC Application Package at `/processes/{processID}/package` (OGC API - Processes - Part 2, requirement /req/deploy-replace-undeploy/package-get-op), whose `executionUnit` is the pinned CWL. Present only for a CWL-sourced process.","schema_type":"object","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/plan"},{"path":["plan","id"],"id":"@id","required":true,"schema_type":"string","format":"uri","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"@id"},{"path":["plan","type"],"id":"@type","required":true,"const":"Plan","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"@type"},{"path":["plan","executionUnit"],"id":"https://w3id.org/ogc/api/processes/executionUnit","description":"Same link as the Application Package's own `executionUnit` (examples/ogcapppkg.json).","required":true,"schema_type":"object","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://w3id.org/ogc/api/processes/executionUnit"},{"path":["plan","executionUnit","href"],"id":"http://www.w3.org/ns/oa#hasTarget","jsonld_type":"@id","description":"Pinned URL of the CWL document.","required":true,"schema_type":"string","format":"uri","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"http://www.w3.org/ns/oa#hasTarget"},{"path":["plan","executionUnit","type"],"id":"http://purl.org/dc/terms/format","required":true,"schema_type":"string","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"http://purl.org/dc/terms/format"},{"path":["plan","executionUnit","rel"],"id":"http://www.iana.org/assignments/relation","jsonld_type":"@id","schema_type":"string","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"http://www.iana.org/assignments/relation"},{"path":["plan","cwlClass"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/cwlClass","required":true,"enum":["CommandLineTool","Workflow","ExpressionTool"],"sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/cwlClass"},{"path":["plan","cwlId"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/cwlId","required":true,"schema_type":"string","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/cwlId"},{"path":["plan","license"],"id":"http://purl.org/dc/terms/license","jsonld_type":"@id","schema_type":"string","format":"uri","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"http://purl.org/dc/terms/license"},{"path":["plan","cctDependencies"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/cctDependency","description":"EOAP CWL custom types used by the CWL.","schema_type":"array","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/cctDependency"},{"path":["plan","candidateCctDependencies"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/candidateCctDependency","description":"EOAP CWL custom types that could replace plain CWL types (not used by the CWL).","schema_type":"array","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/candidateCctDependency"},{"path":["serverSideFiles"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/serverSideFile","description":"Inputs and outputs that this deployment passes as names of files stored on the server (relative to the ZOO-Kernel `dataPath`), not as encoded data, so with no media type. Each names the Implementation Profile role whose format the file has (`implements`).","schema_type":"array","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/serverSideFile"},{"path":["serverSideFiles","name"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/liveName","required":true,"schema_type":"string","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/liveName"},{"path":["serverSideFiles","side"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/side","required":true,"enum":["inputs","outputs"],"sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/side"},{"path":["serverSideFiles","implements"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/implements","jsonld_type":"@id","required":true,"schema_type":"string","format":"uri","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/implements"},{"path":["serverSideFiles","location"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/location","required":true,"schema_type":"string","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/location"},{"path":["byReference"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/byReference","description":"Bound inputs and outputs, of a role with a representation, that this deployment takes or returns as a URL of the data instead of the data (C1, 2026-11-10): the representation describes what the URL resolves to. Reported apart, like serverSideFiles.","schema_type":"array","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/byReference"},{"path":["byReference","name"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/liveName","required":true,"schema_type":"string","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/liveName"},{"path":["byReference","side"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/side","required":true,"enum":["inputs","outputs"],"sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/side"},{"path":["byReference","implements"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/implements","jsonld_type":"@id","required":true,"schema_type":"string","format":"uri","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/implements"},{"path":["byReference","note"],"id":"http://www.w3.org/2004/02/skos/core#note","required":true,"schema_type":"string","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"http://www.w3.org/2004/02/skos/core#note"},{"path":["unboundRoles"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/unboundRole","description":"Implementation Profile roles this deployment leaves unbound, each with its reason: a role of minOccurs 0 at tier 3 (C2, 2026-11-10), or, for a live process of the testbed, an input its deployment does not expose.","schema_type":"array","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/unboundRole"},{"path":["unboundRoles","side"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/side","required":true,"enum":["inputs","outputs"],"sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/side"},{"path":["unboundRoles","implements"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/implements","jsonld_type":"@id","required":true,"schema_type":"string","format":"uri","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/implements"},{"path":["unboundRoles","reason"],"id":"http://www.w3.org/2004/02/skos/core#note","required":true,"schema_type":"string","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"http://www.w3.org/2004/02/skos/core#note"},{"path":["fixedRoleValues"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/fixedRoleValue","description":"Optional Implementation Profile roles (minOccurs 0) that this deployment leaves unbound because it fixes their value (C3, 2026-11-10): e.g. the index computed by a normalized-difference tool.","schema_type":"array","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/fixedRoleValue"},{"path":["fixedRoleValues","side"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/side","required":true,"enum":["inputs","outputs"],"sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/side"},{"path":["fixedRoleValues","implements"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/implements","jsonld_type":"@id","required":true,"schema_type":"string","format":"uri","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/implements"},{"path":["fixedRoleValues","values"],"id":"http://www.w3.org/1999/02/22-rdf-syntax-ns#value","required":true,"schema_type":"array","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"http://www.w3.org/1999/02/22-rdf-syntax-ns#value"},{"path":["fixedRoleValues","reason"],"id":"http://www.w3.org/2004/02/skos/core#note","required":true,"schema_type":"string","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"http://www.w3.org/2004/02/skos/core#note"},{"path":["roleDecompositions"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/roleDecomposition","description":"Implementation Profile roles that this deployment takes as one or more inputs (or outputs) none of which is the role: a role with a representation none of the parts carries (the bounding box of raster-crop taken by OTB.ExtractROI as four corner numbers), or a literal role (C11, 2026-11-10: a time interval given by `days_back`, or by `date` + `delta`). `reproducible` is false when the parts depend on the time of execution.","schema_type":"array","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/roleDecomposition"},{"path":["roleDecompositions","side"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/side","required":true,"enum":["inputs","outputs"],"sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/side"},{"path":["roleDecompositions","implements"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/implements","jsonld_type":"@id","required":true,"schema_type":"string","format":"uri","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/implements"},{"path":["roleDecompositions","parts"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/part","required":true,"schema_type":"array","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/part"},{"path":["roleDecompositions","note"],"id":"http://www.w3.org/2004/02/skos/core#note","required":true,"schema_type":"string","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"http://www.w3.org/2004/02/skos/core#note"},{"path":["roleDecompositions","selectors"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/selector","description":"The conditions under which the parts implement the role: each a deployed input and the values it must take.","schema_type":"array","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/selector"},{"path":["roleDecompositions","selectors","name"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/liveName","required":true,"schema_type":"string","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/liveName"},{"path":["roleDecompositions","selectors","values"],"id":"http://www.w3.org/1999/02/22-rdf-syntax-ns#value","required":true,"schema_type":"array","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"http://www.w3.org/1999/02/22-rdf-syntax-ns#value"},{"path":["roleDecompositions","reproducible"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/reproducible","jsonld_type":"http://www.w3.org/2001/XMLSchema#boolean","schema_type":"boolean","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/reproducible"},{"path":["assumedFormatGaps"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/assumedFormatGap","description":"Bound inputs and outputs whose Implementation Profile representation this deployment does not serve (no media type exposed), accepted with a reason and its evidence (A4.3, docs/FORMAT-CHECK.md).","schema_type":"array","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/assumedFormatGap"},{"path":["assumedFormatGaps","name"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/liveName","required":true,"schema_type":"string","sources":["bblocks://ospd.process-profiles.process-type"],"effectiveId":"https://geolabs.github.io/bblocks-process-profiles/def/liveName"},{"path":["assumedFormatGaps","side"],"id":"https://geolabs.github.io/bblocks-process-profiles/def/side","required":true,"enum":["inputs","outp