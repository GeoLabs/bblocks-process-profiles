{
  "id": "Buffer",
  "title": "Create a buffer around a polygon. ",
  "description": "This service shall return a feature collection representing the buffer of geometry InputPolygon at distance BufferDistance. The buffer of a geometry at distance d is the Polygon or MultiPolygon which contains all points within a distance d of the geometry.",
  "version": "2.0.0",
  "jobControlOptions": [
    "sync-execute",
    "async-execute",
    "dismiss"
  ],
  "outputTransmission": [
    "value",
    "reference"
  ],
  "mutable": false,
  "metadata": [
    {
      "title": "Process Concept: Vector Geometry Processing",
      "role": "http://www.opengis.net/spec/wps/2.0/def/process-profile/concept",
      "href": "https://w3id.org/geolabs/ospd/generic-profiles/concept/vector-geometry-processing"
    },
    {
      "title": "Generic Profile: Geometry buffer",
      "role": "http://www.opengis.net/spec/wps/2.0/def/process-profile/generic",
      "href": "https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/geometry-buffer"
    },
    {
      "title": "Implementation Profile: Buffer",
      "role": "http://www.opengis.net/spec/wps/2.0/def/process-profile/implementation",
      "href": "https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/buffer"
    },
    {
      "title": "Demo"
    }
  ],
  "links": [
    {
      "rel": "http://www.opengis.net/def/rel/ogc/1.0/execute",
      "type": "application/json",
      "title": "Execute End Point",
      "href": "https://host1.tb.geonovum.geolabs.fr/ogc-api/processes/Buffer/execution"
    }
  ],
  "keywords": [
    "vector",
    "geometry",
    "spatial analysis",
    "buffer",
    "Buffer"
  ],
  "inputs": {
    "InputPolygon": {
      "title": "Polygon to be buffered",
      "description": "URI to a set of GML that describes the polygon.",
      "dataType": "https://w3id.org/geolabs/ospd/data-types/data-type/geometry",
      "keywords": [
        "geometry"
      ],
      "metadata": [
        {
          "title": "Generic Profile: Geometry buffer -- input `geometry`",
          "role": "https://w3id.org/geolabs/ospd/generic-profiles/role/generic-input",
          "href": "https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/geometry-buffer/inputs/geometry"
        },
        {
          "title": "Implementation Profile: Buffer -- input `geometry`",
          "role": "https://w3id.org/geolabs/ospd/generic-profiles/role/implementation-input",
          "href": "https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/buffer/inputs/geometry"
        },
        {
          "title": "Mon test  "
        }
      ],
      "schema": {
        "oneOf": [
          {
            "type": "string",
            "contentEncoding": "UTF-8",
            "contentMediaType": "text/xml",
            "contentSchema": "http://fooa/gml/3.1.0/polygon.xsd"
          },
          {
            "type": "object"
          }
        ]
      }
    },
    "BufferDistance": {
      "title": "Buffer Distance",
      "description": "Distance to be used to calculate buffer.",
      "dataType": "https://w3id.org/geolabs/ospd/data-types/data-type/number",
      "keywords": [
        "distance"
      ],
      "metadata": [
        {
          "title": "Generic Profile: Geometry buffer -- input `distance`",
          "role": "https://w3id.org/geolabs/ospd/generic-profiles/role/generic-input",
          "href": "https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/geometry-buffer/inputs/distance"
        },
        {
          "title": "Implementation Profile: Buffer -- input `distance`",
          "role": "https://w3id.org/geolabs/ospd/generic-profiles/role/implementation-input",
          "href": "https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/buffer/inputs/distance"
        }
      ],
      "minOccurs": 0,
      "schema": {
        "type": "number",
        "default": 10,
        "format": "float",
        "nullable": true
      }
    }
  },
  "outputs": {
    "Result": {
      "title": "Buffered Polygon",
      "description": "GML stream describing the buffered polygon feature.",
      "dataType": "https://w3id.org/geolabs/ospd/data-types/data-type/surface",
      "keywords": [
        "geometry"
      ],
      "metadata": [
        {
          "title": "Generic Profile: Geometry buffer -- output `result`",
          "role": "https://w3id.org/geolabs/ospd/generic-profiles/role/generic-output",
          "href": "https://w3id.org/geolabs/ospd/generic-profiles/generic-profile/geometry-buffer/outputs/result"
        },
        {
          "title": "Implementation Profile: Buffer -- output `result`",
          "role": "https://w3id.org/geolabs/ospd/generic-profiles/role/implementation-output",
          "href": "https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/buffer/outputs/result"
        },
        {
          "title": "Mon test  "
        }
      ],
      "schema": {
        "oneOf": [
          {
            "type": "string",
            "contentEncoding": "UTF-8",
            "contentMediaType": "text/xml",
            "contentSchema": "http://fooa/gml/3.1.0/polygon.xsd"
          },
          {
            "type": "object"
          }
        ]
      }
    }
  }
}
