# Must fail: a tier-4 output of data type binary-mask names raster-single-band-geotiff, which
# realizes raster-single-band, the broader type, not binary-mask (the mismatch of otsu before
# 2026-11-18). Only the SPARQL constraint of pp:Tier4RepresentationShape can reject it.
@prefix proc: <https://w3id.org/ogc/api/processes/> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix gp:   <https://w3id.org/geolabs/ospd/generic-profiles/> .
@prefix in:   <https://w3id.org/geolabs/ospd/process-profiles/input/> .
@prefix out:  <https://w3id.org/geolabs/ospd/process-profiles/output/> .
@prefix ex:   <https://w3id.org/geolabs/ospd/process-profiles/process/> .

ex:fixture-representation-other proc:outputs [ out:mask ex:fixture-representation-other-output ] .
ex:fixture-representation-other-output dct:title "Mask" ;
    dct:type <https://w3id.org/geolabs/ospd/data-types/data-type/binary-mask> ;
    gp:representation <https://w3id.org/geolabs/ospd/data-formats/representation/raster-single-band-geotiff> .
