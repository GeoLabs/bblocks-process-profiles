# Must pass: a bound tier-4 input with a real data type concept (it passes sh:class only if the
# concept reaches the closure through data-types.vocabulary and the url-mappings), an output with a
# real concept, and an input of the deployment's own, unbound, with no dataType and a reference to the
# Generic Profile role only. The bound input and the output name representations that realize
# their data types (pp:Tier4RepresentationShape, decision of 2026-11-18), including one whose format
# is a JSON Schema string format (date).
@prefix proc: <https://w3id.org/ogc/api/processes/> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix gp:   <https://w3id.org/geolabs/ospd/generic-profiles/> .
@prefix in:   <https://w3id.org/geolabs/ospd/process-profiles/input/> .
@prefix out:  <https://w3id.org/geolabs/ospd/process-profiles/output/> .
@prefix ex:   <https://w3id.org/geolabs/ospd/process-profiles/process/> .

ex:fixture-control proc:inputs [ in:InputDSN ex:fixture-control-input ; in:ram ex:fixture-control-own ; in:DATE_MIN ex:fixture-control-date ] ;
    proc:outputs [ out:Result ex:fixture-control-output ] .
ex:fixture-control-input dct:title "Input" ;
    dct:type <https://w3id.org/geolabs/ospd/data-types/data-type/raster> ;
    gp:representation <https://w3id.org/geolabs/ospd/data-formats/representation/raster-geotiff>,
        <https://w3id.org/geolabs/ospd/data-formats/representation/raster-jpeg2000> ;
    proc:metadata [ proc:role <https://w3id.org/geolabs/ospd/generic-profiles/role/implementation-input> ;
                   proc:href <https://w3id.org/geolabs/ospd/generic-profiles/implementation-profile/raster-reprojection/inputs/raster> ] .
ex:fixture-control-own dct:title "Available memory" .
ex:fixture-control-output dct:title "Output" ;
    dct:type <https://w3id.org/geolabs/ospd/data-types/data-type/raster-single-band> ;
    gp:representation <https://w3id.org/geolabs/ospd/data-formats/representation/raster-single-band-geotiff> .
ex:fixture-control-date dct:title "Day (min value)" ;
    dct:type <https://w3id.org/geolabs/ospd/data-types/data-type/date> ;
    gp:representation <https://w3id.org/geolabs/ospd/data-formats/representation/date-string-date> .
