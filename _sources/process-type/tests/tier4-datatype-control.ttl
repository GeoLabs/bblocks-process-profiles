# Must pass: a bound tier-4 input with a real data type concept (it passes sh:class only if the
# concept reaches the closure through data-types.vocabulary and the url-mappings), an output with a
# real concept, and an input of the deployment's own, unbound, with no dataType and a reference to the
# Generic Profile role only.
@prefix proc: <https://w3id.org/ogc/api/processes/> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix in:   <https://geolabs.github.io/bblocks-process-profiles/def/input/> .
@prefix out:  <https://geolabs.github.io/bblocks-process-profiles/def/output/> .
@prefix ex:   <https://geolabs.github.io/bblocks-process-profiles/def/process/> .

ex:fixture-control proc:inputs [ in:InputDSN ex:fixture-control-input ; in:ram ex:fixture-control-own ] ;
    proc:outputs [ out:Result ex:fixture-control-output ] .
ex:fixture-control-input dct:title "Input" ;
    dct:type <https://geolabs.github.io/bblocks-data-types/def/data-type/raster> ;
    proc:metadata [ proc:role <https://geolabs.github.io/bblocks-generic-profiles/def/role/implementation-input> ;
                   proc:href <https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/raster-reprojection/inputs/raster> ] .
ex:fixture-control-own dct:title "Available memory" .
ex:fixture-control-output dct:title "Output" ;
    dct:type <https://geolabs.github.io/bblocks-data-types/def/data-type/raster-single-band> .
