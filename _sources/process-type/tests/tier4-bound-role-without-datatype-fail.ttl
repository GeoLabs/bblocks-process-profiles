# Must fail: a tier-4 input bound to an Implementation Profile role (implementation-input reference)
# with no dataType. Only pp:Tier4BoundRoleDataTypeShape can reject it (sh:minCount 1).
@prefix proc: <https://w3id.org/ogc/api/processes/> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix in:   <https://geolabs.github.io/bblocks-process-profiles/def/input/> .
@prefix out:  <https://geolabs.github.io/bblocks-process-profiles/def/output/> .
@prefix ex:   <https://geolabs.github.io/bblocks-process-profiles/def/process/> .

ex:fixture-bound-without proc:inputs [ in:InputDSN ex:fixture-bound-without-input ] .
ex:fixture-bound-without-input dct:title "Input" ;
    proc:metadata [ proc:role <https://geolabs.github.io/bblocks-generic-profiles/def/role/implementation-input> ;
                   proc:href <https://geolabs.github.io/bblocks-generic-profiles/def/implementation-profile/raster-reprojection/inputs/raster> ] .
