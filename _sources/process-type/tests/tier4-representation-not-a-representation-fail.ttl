# Must fail: a tier-4 input names a df:Format (geotiff) as its representation, not a
# df:Representation. Only the sh:class of pp:Tier4RepresentationShape can reject it (the SPARQL
# constraint rejects it too: a format realizes nothing).
@prefix proc: <https://w3id.org/ogc/api/processes/> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix gp:   <https://w3id.org/geolabs/ospd/generic-profiles/> .
@prefix in:   <https://w3id.org/geolabs/ospd/process-profiles/input/> .
@prefix out:  <https://w3id.org/geolabs/ospd/process-profiles/output/> .
@prefix ex:   <https://w3id.org/geolabs/ospd/process-profiles/process/> .

ex:fixture-representation-format proc:inputs [ in:raster ex:fixture-representation-format-input ] .
ex:fixture-representation-format-input dct:title "Raster" ;
    dct:type <https://w3id.org/geolabs/ospd/data-types/data-type/raster> ;
    gp:representation <https://w3id.org/geolabs/ospd/data-formats/format/geotiff> .
